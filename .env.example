# Analytics remains disabled unless both values are configured for a production build.
# Development builds always leave analytics disabled, regardless of these values.
PUBLIC_ANALYTICS_ENABLED=false
PUBLIC_PLAUSIBLE_DOMAIN=

# Google AdSense is disabled by default and always disabled in development.
# Use the public client ID and numeric responsive-ad-unit IDs from AdSense only
# after a compliant consent message and privacy disclosure are live.
PUBLIC_ADS_ENABLED=false
PUBLIC_ADSENSE_CLIENT=
PUBLIC_ADSENSE_BANNER_SLOT=
PUBLIC_ADSENSE_INLINE_SLOT=
PUBLIC_ADSENSE_RAIL_SLOT=
