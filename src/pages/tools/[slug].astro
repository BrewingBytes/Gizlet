---
import ToolPageLayout from '../../components/ToolPageLayout.astro';
import CompressImageTool from '../../components/CompressImageTool.astro';
import ConvertImageTool from '../../components/ConvertImageTool.astro';
import JsonLdGeneratorTool from '../../components/JsonLdGeneratorTool.astro';
import JpgToPdfTool from '../../components/JpgToPdfTool.astro';
import JsonFormatterTool from '../../components/JsonFormatterTool.astro';
import MergePdfTool from '../../components/MergePdfTool.astro';
import PdfToJpgTool from '../../components/PdfToJpgTool.astro';
import PdfViewerTool from '../../components/PdfViewerTool.astro';
import ResizeImageTool from '../../components/ResizeImageTool.astro';
import { getRelatedTools } from '../../data/tool-page-related';
import { getToolProcessingDescription } from '../../data/tool-page-status';
import {
  isAvailableTool,
  toolRegistry,
  type AvailableToolSlug,
  type RegisteredTool,
  type ToolRegistryEntry,
} from '../../data/tools';

interface Props {
  tool: RegisteredTool;
  relatedTools: readonly ToolRegistryEntry[];
}

export function getStaticPaths() {
  return toolRegistry.map((tool) => ({
    params: { slug: tool.slug },
    props: {
      tool,
      relatedTools: getRelatedTools(tool),
    },
  }));
}

/**
 * One workspace per published Gizlet. The map is total over the registry's
 * available slugs, so a new Gizlet cannot reach production without one.
 */
const toolWorkspaces = {
  'compress-image': CompressImageTool,
  'resize-image': ResizeImageTool,
  'convert-image': ConvertImageTool,
  'json-ld-generator': JsonLdGeneratorTool,
  'json-formatter': JsonFormatterTool,
  'jpg-to-pdf': JpgToPdfTool,
  'pdf-viewer': PdfViewerTool,
  'merge-pdf': MergePdfTool,
  'pdf-to-jpg': PdfToJpgTool,
} as const satisfies Record<AvailableToolSlug, unknown>;

const { tool, relatedTools } = Astro.props;
// Launch status decides whether there is a workspace at all; the slug only
// decides which one.
const Workspace = isAvailableTool(tool) ? toolWorkspaces[tool.slug] : undefined;
---

<ToolPageLayout
  tool={tool}
  relatedTools={relatedTools}
  processingStatus={getToolProcessingDescription(tool.slug)}
  showRail
  showPostResultAd
>
  {
    Workspace ? (
      <div slot="workspace"><Workspace /></div>
    ) : (
      <section slot="workspace" class="tool-page-placeholder" aria-labelledby="workspace-title">
        <p class="metadata">Coming soon</p>
        <h2 id="workspace-title">This Gizlet is being prepared.</h2>
        <p>Its workspace will live here, ready for one job done properly.</p>
      </section>
    )
  }

  {
    !Workspace && (
      <section slot="result" class="tool-page-placeholder__result" aria-label="Tool result area">
        <p class="metadata">Results will appear here</p>
      </section>
    )
  }
</ToolPageLayout>

<style>
  .tool-page-placeholder {
    padding: var(--space-5);
    border: var(--border-strong-width) solid var(--text);
    background: var(--surface);
  }

  .tool-page-placeholder .metadata {
    margin-bottom: var(--space-2);
  }

  .tool-page-placeholder h2 {
    max-width: 30rem;
  }

  .tool-page-placeholder p:last-child {
    max-width: 34rem;
    margin-bottom: 0;
    color: var(--text-muted);
  }

  .tool-page-placeholder__result {
    min-height: 4rem;
    padding: var(--space-3) 0;
    border-top: var(--border-width) solid var(--border);
  }

  .tool-page-placeholder__result .metadata {
    margin: 0;
  }
</style>
