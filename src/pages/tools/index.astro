---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NotBuiltYet from '../../components/NotBuiltYet.astro';
import { getPageMetadata } from '../../data/metadata';
import { toolIndexSocialImagePath } from '../../data/social-images';
import { getToolIndexStructuredData } from '../../data/structured-data';
import { getToolCategoryPage } from '../../data/tool-categories';
import { getToolCategoryGroups } from '../../data/tools';

const metadata = getPageMetadata({
  title: 'All Gizlets | Gizlet',
  description: 'Every Gizlet that works, grouped by the kind of job it does, and every one we have not built.',
  pathname: '/tools/',
  image: toolIndexSocialImagePath,
});
// The jump links keep pointing at the anchors below; each group's own heading
// links out to the category's standalone page.
const categoryGroups = getToolCategoryGroups().map((group) => ({
  ...group,
  page: getToolCategoryPage(group.category),
}));
---

<BaseLayout metadata={metadata} structuredData={getToolIndexStructuredData()}>
  <section class="tool-catalogue" aria-labelledby="tool-catalogue-title">
    <p class="metadata">Every Gizlet</p>
    <h1 id="tool-catalogue-title">All the Gizlets, by kind of job.</h1>
    <p class="tool-catalogue__copy">
      Each one runs in this browser, needs no account, and does a single job. The categories below
      hold Gizlets that work; what we have not built yet is listed after them, with the phase that
      explains the order.
    </p>

    <nav class="tool-catalogue__jump" aria-label="Jump to a category">
      <ul>
        {
          categoryGroups.map((group) => (
            <li><a href={group.path}>{group.label}</a></li>
          ))
        }
      </ul>
    </nav>

    {
      categoryGroups.map((group) => (
        <section
          class="tool-catalogue__group"
          id={group.category}
          aria-labelledby={`${group.category}-title`}
        >
          <div class="tool-catalogue__group-heading">
            <h2 id={`${group.category}-title`}>{group.label}</h2>
            {group.page && <a href={group.page.path}>{group.page.heading} guide</a>}
          </div>
          <ol class="tool-catalogue__list">
            {group.tools.map((tool) => (
              <li>
                <a href={tool.path}>
                  <span class="tool-catalogue__number">{String(tool.id).padStart(3, '0')}</span>
                  <span>
                    <strong>{tool.name}</strong>
                    <span>{tool.description}</span>
                  </span>
                  {tool.processesLocally && <span class="status-local">Local</span>}
                </a>
              </li>
            ))}
          </ol>
        </section>
      ))
    }

    <NotBuiltYet />
  </section>
</BaseLayout>

<style>
  .tool-catalogue {
    max-width: 60rem;
  }

  .tool-catalogue__copy {
    max-width: 38rem;
    color: var(--text-muted);
    font-size: var(--font-size-lg);
  }

  .tool-catalogue__jump ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    margin: var(--space-5) 0 0;
    padding: 0;
    list-style: none;
  }

  .tool-catalogue__jump a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    font-weight: 700;
  }

  .tool-catalogue__group {
    margin-top: var(--space-6);
  }

  .tool-catalogue__group-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-1) var(--space-3);
    padding-bottom: var(--space-2);
    border-bottom: var(--border-strong-width) solid var(--text);
  }

  .tool-catalogue__group-heading h2 {
    margin: 0;
  }

  .tool-catalogue__group-heading a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
  }

  .tool-catalogue__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tool-catalogue__list li {
    border-bottom: var(--border-width) solid var(--border);
  }

  .tool-catalogue__list a {
    display: grid;
    grid-template-columns: 3ch minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-3);
    min-height: 3.5rem;
    padding: var(--space-2);
    color: var(--text);
    text-decoration: none;
  }

  .tool-catalogue__list a:hover {
    background: var(--surface);
  }

  /* The number is the shipped-Gizlet credential the not-built rows withhold, so
     the em dash beside a planned row has something to be measured against. */
  .tool-catalogue__number {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
  }

  .tool-catalogue__list a > span:nth-child(2) {
    display: grid;
    gap: var(--space-1);
  }

  .tool-catalogue__list strong {
    font-family: var(--font-display);
    font-size: var(--font-size-lg);
  }

  .tool-catalogue__list a > span:nth-child(2) span {
    color: var(--text-muted);
  }
</style>
