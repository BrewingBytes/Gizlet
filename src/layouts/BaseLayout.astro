---
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import ToolSearchOverlay from '../components/ToolSearchOverlay.astro';
import { getAnalyticsConfiguration, plausibleScriptUrl } from '../data/analytics';
import { getPageMetadata, type PageMetadata } from '../data/metadata';
import '../styles/global.css';

interface Props {
  description?: string;
  image?: string;
  metadata?: PageMetadata;
  pathname?: string;
  robots?: string;
  title?: string;
}

const {
  description,
  image,
  metadata: suppliedMetadata,
  pathname = Astro.url.pathname,
  robots,
  title,
} = Astro.props;
const metadata = suppliedMetadata ?? getPageMetadata({ title, description, pathname, image, robots });
const analytics = getAnalyticsConfiguration({
  isDevelopment: import.meta.env.DEV,
  enabled: import.meta.env.PUBLIC_ANALYTICS_ENABLED,
  plausibleDomain: import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN,
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={metadata.description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content={metadata.robots} />
    <link rel="canonical" href={metadata.canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={metadata.title} />
    <meta property="og:description" content={metadata.description} />
    <meta property="og:url" content={metadata.canonicalUrl} />
    <meta property="og:image" content={metadata.socialImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={metadata.title} />
    <meta name="twitter:description" content={metadata.description} />
    <meta name="twitter:image" content={metadata.socialImageUrl} />
    <link rel="icon" type="image/svg+xml" href="/brand/favicon.svg" />
    <link rel="icon" href="/brand/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/brand/icons/gizlet-180.png" />
    <title>{metadata.title}</title>
    <script is:inline>
      {`(() => {
        const preference = localStorage.getItem('gizlet-theme');
        const theme = preference === 'dark' || preference === 'light'
          ? preference
          : matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = theme;
      })()`}
    </script>
    {
      analytics.enabled && analytics.plausibleDomain && (
        <>
          <script is:inline>
            {`window.plausible = window.plausible || function () {
              (window.plausible.q = window.plausible.q || []).push(arguments);
            };`}
          </script>
          <script is:inline defer data-domain={analytics.plausibleDomain} src={plausibleScriptUrl}></script>
        </>
      )
    }
  </head>
  <body>
    <div class="site-shell">
      <a class="skip-link" href="#main-content">Skip to content</a>
      <SiteHeader />
      <ToolSearchOverlay />
      <main id="main-content" class="site-main" tabindex="-1">
        <div class="site-container">
          <slot />
        </div>
      </main>
      <SiteFooter />
    </div>
  </body>
</html>

<script>
  import { initialiseAnalytics } from '../scripts/analytics';
  import { initialiseToolSearch } from '../scripts/tool-search';

  initialiseAnalytics();
  initialiseToolSearch();
</script>
