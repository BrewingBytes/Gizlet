---
import ConsentBanner from '../components/ConsentBanner.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import ToolSearchOverlay from '../components/ToolSearchOverlay.astro';
import {
  adSensePublisherId,
  adSenseScriptBaseUrl,
  type PageAdvertisementPolicy,
} from '../data/advertising';
import { getAnalyticsConfiguration } from '../data/analytics';
import { deniedConsentSignals } from '../data/consent';
import { getPageMetadata, type PageMetadata } from '../data/metadata';
import {
  serialiseStructuredData,
  type StructuredDataItem,
} from '../data/structured-data';
import '../styles/global.css';

interface Props {
  description?: string;
  advertising?: PageAdvertisementPolicy;
  image?: string;
  metadata?: PageMetadata;
  pathname?: string;
  robots?: string;
  structuredData?: readonly StructuredDataItem[];
  title?: string;
}

const {
  advertising,
  description,
  image,
  metadata: suppliedMetadata,
  pathname = Astro.url.pathname,
  robots,
  structuredData,
  title,
} = Astro.props;
const metadata = suppliedMetadata ?? getPageMetadata({ title, description, pathname, image, robots });
const adSenseClient = advertising?.enabled ? advertising.adSenseClient : undefined;
const analytics = getAnalyticsConfiguration({
  isDevelopment: import.meta.env.DEV,
  enabled: import.meta.env.PUBLIC_ANALYTICS_ENABLED,
  measurementId: import.meta.env.PUBLIC_GA4_MEASUREMENT_ID,
});
/**
 * Consent Mode defaults must be in place before any tag loads, so they are
 * declared inline rather than imported. The denied set is read from the consent
 * module so the document and the banner cannot disagree about what a visitor
 * who has chosen nothing is signalling.
 */
const consentDefaultsScript = `window.dataLayer=window.dataLayer||[];`
  + `window.gtag=function(){window.dataLayer.push(arguments);};`
  + `window.gtag('consent','default',${JSON.stringify(deniedConsentSignals)});`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="google-adsense-account" content={adSensePublisherId} />
    <meta name="description" content={metadata.description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content={metadata.robots} />
    <link rel="canonical" href={metadata.canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={metadata.title} />
    <meta property="og:description" content={metadata.description} />
    <meta property="og:url" content={metadata.canonicalUrl} />
    <meta property="og:image" content={metadata.socialImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={metadata.title} />
    <meta name="twitter:description" content={metadata.description} />
    <meta name="twitter:image" content={metadata.socialImageUrl} />
    <link rel="icon" type="image/svg+xml" href="/brand/favicon.svg" />
    <link rel="icon" href="/brand/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/brand/icons/gizlet-180.png" />
    <title>{metadata.title}</title>
    {
      structuredData && structuredData.length > 0 && (
        <script
          is:inline
          type="application/ld+json"
          set:html={serialiseStructuredData(structuredData)}
        />
      )
    }
    <script is:inline>
      (() => {
        let preference = null;

        try {
          preference = localStorage.getItem('gizlet-theme');
        } catch {
          // System preference remains the fallback when storage is unavailable.
        }

        const theme = preference === 'dark' || preference === 'light'
          ? preference
          : matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = theme;
      })();
    </script>
    {analytics.enabled && <script is:inline set:html={consentDefaultsScript} />}
    {
      adSenseClient && (
        <script
          is:inline
          async
          src={`${adSenseScriptBaseUrl}?client=${adSenseClient}`}
          crossorigin="anonymous"
        ></script>
      )
    }
  </head>
  <body data-ga-measurement-id={analytics.measurementId}>
    <div class="site-shell">
      <a class="skip-link" href="#main-content">Skip to content</a>
      <SiteHeader />
      <ToolSearchOverlay />
      <main id="main-content" class="site-main" tabindex="-1">
        <div class="site-container">
          <slot />
        </div>
      </main>
      <SiteFooter />
      {analytics.enabled && <ConsentBanner />}
    </div>
  </body>
</html>

<script>
  import { initialiseAnalytics } from '../scripts/analytics';
  import { initialiseToolSearch } from '../scripts/tool-search';

  initialiseAnalytics();
  initialiseToolSearch();
</script>
