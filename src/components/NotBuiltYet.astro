---
import { getPlannedGizletRequestPath } from '../data/gizlet-request';
import {
  getPhaseForPlannedTool,
  getPlannedToolChainEntries,
  getRoadmapPhaseLabel,
  getRoadmapPhasePath,
  roadmapPath,
} from '../data/roadmap';
import { getPlannedToolCategoryGroups, isPlannedTool } from '../data/tools';

/**
 * The bench: every Gizlet the roadmap commits to and no code implements yet.
 *
 * Three rules hold the block together, and each is load-bearing rather than
 * decorative. The heading says "Not built yet." and never "Coming soon",
 * because one is a statement and the other is a promise. A row is not a link:
 * the geometry lives on the `<li>`, so there is no whole-row pointer, hover or
 * underline inviting a visitor to a page that does nothing — and no whole-row
 * `opacity` either, which would only make an honest row hard to read. And a row
 * carries exactly two links: the phase that explains the order, and a request
 * that turns a reader into the one signal this project can actually count.
 *
 * The flow chain is plain text here. A row's link budget is spent, and this
 * page is a page of links to Gizlets that work; the same chain appears with its
 * live steps as real links on the planned Gizlet's own page, where nothing
 * competes with them.
 */
const groups = getPlannedToolCategoryGroups();
const rows = groups.map((group) => ({
  ...group,
  tools: group.tools.filter(isPlannedTool).map((tool) => ({
    tool,
    phase: getPhaseForPlannedTool(tool),
    requestPath: getPlannedGizletRequestPath(tool.slug),
    chain: getPlannedToolChainEntries(tool.slug),
  })),
}));
---

<section class="not-built" aria-labelledby="not-built-title" data-not-built>
  <div class="not-built__intro">
    <p class="metadata">The bench</p>
    <h2 id="not-built-title">Not built yet.</h2>
    <p>
      None of these works. Each row says which <a href={roadmapPath}>phase</a> it belongs to and,
      where it has one, the chain it would finish. There are no dates here, because there are none
      to give.
    </p>
  </div>

  {
    rows.map((group) => (
      <section class="not-built__group" aria-labelledby={`not-built-${group.category}`}>
        <h3 class="metadata not-built__group-title" id={`not-built-${group.category}`}>
          {group.label.toUpperCase()} · {group.tools.length}
        </h3>
        <ul class="not-built__list">
          {group.tools.map(({ tool, phase, requestPath, chain }) => (
            <li class="not-built__row" data-planned-row={tool.slug}>
              <span class="not-built__number" aria-hidden="true">—</span>
              <span class="not-built__details">
                <strong>{tool.name}</strong>
                <span class="not-built__description">{tool.description}</span>
                {chain.length > 0 && (
                  <span class="not-built__chain">
                    {chain.map((step) => step.name).join(' → ')}
                  </span>
                )}
                <a class="not-built__request" href={requestPath}>
                  Ask for {tool.name}
                </a>
              </span>
              <a class="not-built__phase metadata" href={getRoadmapPhasePath(phase)}>
                {getRoadmapPhaseLabel(phase)}
              </a>
              <span class="not-built__category metadata">{tool.category}</span>
            </li>
          ))}
        </ul>
      </section>
    ))
  }

  <p class="not-built__signal">
    Your request opens a public GitHub issue in your name. We count issues, not clicks.
  </p>
</section>

<style>
  .not-built {
    margin-top: var(--space-7);
    padding-top: var(--space-5);
    border-top: var(--border-strong-width) solid var(--text);
  }

  .not-built__intro {
    max-width: 38rem;
  }

  .not-built__intro .metadata,
  .not-built__intro h2 {
    margin-bottom: var(--space-2);
  }

  .not-built__intro p:last-child {
    margin-bottom: 0;
    color: var(--text-muted);
  }

  .not-built__group {
    margin-top: var(--space-5);
  }

  .not-built__group-title {
    margin: 0 0 var(--space-1);
    font-weight: 700;
  }

  .not-built__list {
    margin: 0;
    padding: 0;
    /* Dashed against the solid rules the live groups use: the divider itself
       says these rows are a different kind of thing. */
    border-top: var(--border-width) dashed var(--border);
    list-style: none;
  }

  .not-built__row {
    /* The geometry belongs to the row, because the row is not a link. */
    display: grid;
    grid-template-columns: 3ch minmax(0, 1fr) auto auto;
    gap: var(--space-1) var(--space-3);
    align-items: start;
    min-height: 3.5rem;
    padding: var(--space-2);
    border-bottom: var(--border-width) dashed var(--border);
  }

  .not-built__number {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
  }

  .not-built__details {
    display: grid;
    gap: var(--space-1);
  }

  .not-built__details strong {
    font-family: var(--font-display);
    font-size: var(--font-size-lg);
  }

  .not-built__description {
    color: var(--text-muted);
  }

  .not-built__chain {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
  }

  .not-built__request {
    justify-self: start;
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    font-size: var(--font-size-sm);
    font-weight: 700;
  }

  .not-built__phase,
  .not-built__category {
    padding-top: 0.35rem;
  }

  .not-built__phase {
    font-weight: 700;
    white-space: nowrap;
  }

  .not-built__signal {
    max-width: 38rem;
    margin-top: var(--space-5);
    margin-bottom: 0;
    padding-left: var(--space-3);
    border-left: var(--border-strong-width) solid var(--color-amber);
    color: var(--text-muted);
  }

  @media (max-width: 44rem) {
    .not-built__row {
      grid-template-columns: 3ch minmax(0, 1fr);
    }

    .not-built__phase,
    .not-built__category {
      grid-column: 2;
      padding-top: 0;
    }
  }
</style>
