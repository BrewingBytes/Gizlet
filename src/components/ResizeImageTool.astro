---
---

<section class="resize-image-tool" data-resize-image-tool>
  <div class="resize-image-tool__picker" data-drop-zone>
    <input
      id="resize-image-file"
      class="resize-image-tool__file-input"
      type="file"
      accept="image/jpeg,image/png,image/webp,image/avif,image/bmp,.jpg,.jpeg,.png,.webp,.avif,.bmp"
      aria-label="Select an image to resize"
      data-file-input
      multiple
      hidden
    />
    <p class="metadata">One image, or a batch of them</p>
    <h2>Drop images here</h2>
    <p>JPEG, PNG, WebP, AVIF, or BMP. Nothing leaves this device.</p>
    <button type="button" class="button-secondary" data-select-file>Choose images</button>
  </div>

  <p class="resize-image-tool__status" data-status role="status" aria-live="polite" hidden></p>
  <p class="resize-image-tool__error" data-error role="alert" hidden></p>

  <div class="resize-image-tool__editor" data-editor hidden>
    <figure class="resize-image-tool__preview">
      <img data-preview-image alt="Selected image preview" />
      <figcaption data-input-name></figcaption>
    </figure>

    <div class="resize-image-tool__controls">
      <fieldset>
        <legend>How should it resize?</legend>
        <div class="resize-image-tool__modes">
          <label><input type="radio" name="resize-mode" value="dimensions" checked data-resize-mode /> Exact dimensions</label>
          <label><input type="radio" name="resize-mode" value="percentage" data-resize-mode /> Percentage</label>
        </div>
      </fieldset>

      <div class="resize-image-tool__dimensions" data-dimension-fields>
        <label for="resize-width">Width <span>px</span></label>
        <input id="resize-width" type="number" min="1" step="1" inputmode="numeric" data-width />
        <label for="resize-height">Height <span>px</span></label>
        <input id="resize-height" type="number" min="1" step="1" inputmode="numeric" data-height />
        <label class="resize-image-tool__lock" for="resize-aspect-lock">
          <input id="resize-aspect-lock" type="checkbox" checked data-aspect-lock />
          Keep proportions
        </label>
      </div>

      <div class="resize-image-tool__percentage" data-percentage-fields hidden>
        <label for="resize-percentage">Scale <span>%</span></label>
        <input id="resize-percentage" type="number" min="0.1" max="1000" step="0.1" inputmode="decimal" value="100" data-percentage />
        <p class="utility-text">100% keeps the original size.</p>
      </div>

      <div class="resize-image-tool__summary" aria-live="polite">
        <span class="metadata">Resulting dimensions</span>
        <strong data-dimension-preview></strong>
      </div>

      <p class="resize-image-tool__batch-note" data-batch-note hidden></p>

      <div class="resize-image-tool__format">
        <label for="resize-output-format">Output format</label>
        <select id="resize-output-format" data-output-format>
          <option value="image/jpeg">JPEG</option>
          <option value="image/png">PNG</option>
          <option value="image/webp">WebP</option>
        </select>
      </div>
    </div>

    <div class="resize-image-tool__actions">
      <button type="button" data-resize>Resize it</button>
      <button type="button" class="button-secondary" data-clear>Choose other images</button>
    </div>
  </div>

  <section class="resize-image-tool__result" data-result aria-live="polite" hidden>
    <p class="metadata">Ready to download</p>
    <h2 data-result-title>Right size. Ready to go.</h2>
    <p class="resize-image-tool__result-summary" data-result-summary hidden></p>
    <figure class="resize-image-tool__result-preview" data-result-figure>
      <img data-result-image alt="Resized image preview" />
      <figcaption>Actual resized image</figcaption>
    </figure>
    <dl data-result-dl>
      <div><dt>Original</dt><dd data-original-dimensions></dd></div>
      <div><dt>Resized</dt><dd data-result-dimensions></dd></div>
    </dl>

    <!-- A batch is a list of rows: every picture that worked is a download of
         its own, and every one that did not says why beside it. -->
    <ul class="resize-image-tool__result-list" data-result-list hidden></ul>
    <template data-result-item-template>
      <li>
        <img data-item-image alt="" />
        <div>
          <p data-item-name></p>
          <a data-item-download>Download</a>
        </div>
      </li>
    </template>
    <template data-failure-item-template>
      <li data-failed>
        <div>
          <p data-item-name></p>
          <p data-item-reason></p>
        </div>
      </li>
    </template>

    <div class="resize-image-tool__result-actions">
      <a class="resize-image-tool__download" data-download>Download image</a>
      <button type="button" class="button-secondary" data-result-clear>Choose other images</button>
    </div>
  </section>
</section>

<style>
  .resize-image-tool { border: var(--border-strong-width) solid var(--text); background: var(--surface); }
  .resize-image-tool__picker { padding: var(--space-5); border: 2px dashed var(--border); text-align: center; }
  .resize-image-tool__picker[data-dragging='true'] { border-color: var(--color-amber); background: color-mix(in srgb, var(--color-amber) 12%, var(--surface)); }
  .resize-image-tool__picker[hidden], .resize-image-tool__editor[hidden], .resize-image-tool__result[hidden], .resize-image-tool__dimensions[hidden], .resize-image-tool__percentage[hidden] { display: none; }
  .resize-image-tool__picker h2 { margin-bottom: var(--space-2); }
  .resize-image-tool__picker p:not(.metadata) { margin-bottom: var(--space-4); color: var(--text-muted); }
  .resize-image-tool__status, .resize-image-tool__error { margin: var(--space-3); padding: var(--space-3); border-left: var(--border-strong-width) solid var(--success); color: var(--text-muted); }
  .resize-image-tool__error { border-left-color: var(--color-red); color: var(--color-red); }
  .resize-image-tool__editor, .resize-image-tool__result { padding: var(--space-4); border-top: var(--border-width) solid var(--border); }
  .resize-image-tool__editor { display: grid; gap: var(--space-4); }
  .resize-image-tool__preview { margin: 0; }
  .resize-image-tool__preview img { display: block; max-width: 100%; max-height: 24rem; margin: 0 auto; border: var(--border-width) solid var(--border); }
  .resize-image-tool__preview figcaption { margin-top: var(--space-2); color: var(--text-muted); font-family: var(--font-mono); font-size: var(--font-size-xs); }
  .resize-image-tool__controls { display: grid; gap: var(--space-3); padding-top: var(--space-3); border-top: var(--border-width) solid var(--border); }
  .resize-image-tool__controls fieldset { margin: 0; padding: 0; border: 0; }
  .resize-image-tool__controls legend, .resize-image-tool__controls > div > label { margin-bottom: var(--space-1); font-weight: 700; }
  .resize-image-tool__modes { display: flex; flex-wrap: wrap; gap: var(--space-3); }
  .resize-image-tool__modes label, .resize-image-tool__lock { display: flex; align-items: center; gap: var(--space-1); min-height: 2.75rem; }
  .resize-image-tool__dimensions { display: grid; grid-template-columns: auto minmax(0, 1fr) auto minmax(0, 1fr); align-items: center; gap: var(--space-2); }
  .resize-image-tool__dimensions label span, .resize-image-tool__percentage label span { color: var(--text-muted); font-family: var(--font-mono); font-size: var(--font-size-sm); font-weight: 400; }
  .resize-image-tool__lock { grid-column: 1 / -1; font-weight: 700; }
  .resize-image-tool__percentage { display: grid; grid-template-columns: auto minmax(0, 12rem); align-items: center; gap: var(--space-2); }
  .resize-image-tool__percentage .utility-text { grid-column: 1 / -1; margin: 0; }
  .resize-image-tool__summary { display: flex; align-items: baseline; justify-content: space-between; gap: var(--space-2); padding: var(--space-2); border-top: var(--border-width) solid var(--border); border-bottom: var(--border-width) solid var(--border); }
  .resize-image-tool__summary strong { font-family: var(--font-mono); }
  .resize-image-tool__format { max-width: 20rem; }
  .resize-image-tool__format label { display: block; }
  .resize-image-tool__actions, .resize-image-tool__result-actions { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .resize-image-tool__result h2 { margin-bottom: var(--space-4); }
  .resize-image-tool__result-preview { margin: 0 0 var(--space-4); }
  .resize-image-tool__result-preview img { display: block; max-width: 100%; max-height: 24rem; margin: 0 auto; border: var(--border-width) solid var(--border); }
  .resize-image-tool__result-preview figcaption { margin-top: var(--space-2); color: var(--text-muted); font-family: var(--font-mono); font-size: var(--font-size-xs); }
  .resize-image-tool__result dl { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-2); margin: 0 0 var(--space-4); }
  .resize-image-tool__result dl div { padding: var(--space-2); border-top: var(--border-width) solid var(--border); }
  .resize-image-tool__result dt { color: var(--text-muted); font-family: var(--font-mono); font-size: var(--font-size-xs); text-transform: uppercase; }
  .resize-image-tool__result dd { margin: var(--space-1) 0 0; font-weight: 700; }
  .resize-image-tool__result-figure[hidden], .resize-image-tool__result-list[hidden], .resize-image-tool__result-summary[hidden] { display: none; }
  .resize-image-tool__result-summary { margin: 0 0 var(--space-3); color: var(--text-muted); font-family: var(--font-mono); font-size: var(--font-size-xs); }
  .resize-image-tool__result-list { display: grid; gap: var(--space-2); margin: 0 0 var(--space-4); padding: 0; list-style: none; }
  .resize-image-tool__result-list li { display: flex; align-items: center; gap: var(--space-3); padding: var(--space-2); border: var(--border-width) solid var(--border); background: var(--background); }
  .resize-image-tool__result-list li[data-failed] { border-left: var(--border-strong-width) solid var(--color-red); }
  .resize-image-tool__result-list img { width: 3.5rem; height: 3.5rem; object-fit: contain; background: var(--surface); }
  .resize-image-tool__result-list p { margin: 0; overflow-wrap: anywhere; font-family: var(--font-mono); font-size: var(--font-size-xs); }
  .resize-image-tool__result-list li[data-failed] p + p { color: var(--color-red); }
  .resize-image-tool__result-list a { display: inline-block; margin-top: var(--space-1); font-size: var(--font-size-sm); font-weight: 700; }
  .resize-image-tool__batch-note { margin: 0; color: var(--text-muted); font-size: var(--font-size-sm); }
  .resize-image-tool__batch-note[hidden] { display: none; }
  .resize-image-tool__download { display: inline-block; min-height: 2.75rem; padding: calc(var(--space-2) - 2px) var(--space-3); border: var(--border-strong-width) solid var(--button-background); background: var(--button-background); color: var(--button-text); font-weight: 700; line-height: 1.25; text-decoration: none; }
  .resize-image-tool__download:hover { color: var(--button-text); box-shadow: 3px 3px 0 var(--color-amber); transform: translate(-1px, -1px); }
  @media (max-width: 36rem) { .resize-image-tool__picker, .resize-image-tool__editor, .resize-image-tool__result { padding: var(--space-3); } .resize-image-tool__dimensions { grid-template-columns: auto minmax(0, 1fr); } .resize-image-tool__dimensions label:nth-of-type(2) { grid-column: 1; } .resize-image-tool__dimensions input[data-height] { grid-column: 2; } .resize-image-tool__percentage { grid-template-columns: 1fr; } .resize-image-tool__result dl { grid-template-columns: 1fr; } }
</style>

<script>
  import {
    formatFileSize,
    getInputImageFormat,
    getPreferredOutputFormat,
    isImageOutputFormat,
  } from '../data/image-compression';
  import {
    describeBatchCount,
    getBatchArchiveName,
    getBatchFailures,
    getBatchSuccesses,
    hasBatchOutput,
    summariseBatch,
    validateBatchSelection,
  } from '../data/image-batches';
  import {
    dimensionsFromHeight,
    dimensionsFromWidth,
    getBatchResizeDimensions,
    getResizeOutputFilename,
    isLargeImage,
    validateResizeDimensions,
    type BatchResizeRequest,
    type ImageDimensions,
  } from '../data/image-resize';
  import { checkBatchSize, packImageArchive, readBatchSources, releaseBatch, runImageBatch, type BatchSource } from '../scripts/image-batch';
  import { encodeBrowserImage } from '../scripts/image-processing';

  const root = document.querySelector<HTMLElement>('[data-resize-image-tool]');

  if (root) {
    const fileInput = root.querySelector<HTMLInputElement>('[data-file-input]');
    const selectFileButton = root.querySelector<HTMLButtonElement>('[data-select-file]');
    const dropZone = root.querySelector<HTMLElement>('[data-drop-zone]');
    const status = root.querySelector<HTMLElement>('[data-status]');
    const error = root.querySelector<HTMLElement>('[data-error]');
    const editor = root.querySelector<HTMLElement>('[data-editor]');
    const previewImage = root.querySelector<HTMLImageElement>('[data-preview-image]');
    const inputName = root.querySelector<HTMLElement>('[data-input-name]');
    const resizeModes = root.querySelectorAll<HTMLInputElement>('[data-resize-mode]');
    const dimensionFields = root.querySelector<HTMLElement>('[data-dimension-fields]');
    const percentageFields = root.querySelector<HTMLElement>('[data-percentage-fields]');
    const widthInput = root.querySelector<HTMLInputElement>('[data-width]');
    const heightInput = root.querySelector<HTMLInputElement>('[data-height]');
    const aspectLock = root.querySelector<HTMLInputElement>('[data-aspect-lock]');
    const percentageInput = root.querySelector<HTMLInputElement>('[data-percentage]');
    const dimensionPreview = root.querySelector<HTMLElement>('[data-dimension-preview]');
    const outputFormat = root.querySelector<HTMLSelectElement>('[data-output-format]');
    const resizeButton = root.querySelector<HTMLButtonElement>('[data-resize]');
    const clearButton = root.querySelector<HTMLButtonElement>('[data-clear]');
    const batchNote = root.querySelector<HTMLElement>('[data-batch-note]');
    const result = root.querySelector<HTMLElement>('[data-result]');
    const resultTitle = root.querySelector<HTMLElement>('[data-result-title]');
    const resultSummary = root.querySelector<HTMLElement>('[data-result-summary]');
    const resultFigure = root.querySelector<HTMLElement>('[data-result-figure]');
    const resultDl = root.querySelector<HTMLElement>('[data-result-dl]');
    const resultList = root.querySelector<HTMLUListElement>('[data-result-list]');
    const resultItemTemplate = root.querySelector<HTMLTemplateElement>('[data-result-item-template]');
    const failureItemTemplate = root.querySelector<HTMLTemplateElement>('[data-failure-item-template]');
    const resultImage = root.querySelector<HTMLImageElement>('[data-result-image]');
    const originalDimensions = root.querySelector<HTMLElement>('[data-original-dimensions]');
    const resultDimensions = root.querySelector<HTMLElement>('[data-result-dimensions]');
    const download = root.querySelector<HTMLAnchorElement>('[data-download]');
    const resultClearButton = root.querySelector<HTMLButtonElement>('[data-result-clear]');

    if (!fileInput || !selectFileButton || !dropZone || !status || !error || !editor || !previewImage || !inputName || !dimensionFields || !percentageFields || !widthInput || !heightInput || !aspectLock || !percentageInput || !dimensionPreview || !outputFormat || !resizeButton || !clearButton || !batchNote || !result || !resultTitle || !resultSummary || !resultFigure || !resultDl || !resultList || !resultItemTemplate || !failureItemTemplate || !resultImage || !originalDimensions || !resultDimensions || !download || !resultClearButton) {
      throw new Error('Resize Image tool could not initialise.');
    }

    /**
     * The batch, which is one picture long in the ordinary case. The fields
     * above are filled from the first row, and every row is resized against its
     * own dimensions rather than against those.
     */
    let sources: readonly BatchSource[] = [];
    let sourceDimensions: ImageDimensions | undefined;
    let resultUrl: string | undefined;
    let itemUrls: string[] = [];

    const nextPaint = () => new Promise<void>((resolve) => requestAnimationFrame(() => requestAnimationFrame(() => resolve())));
    const clearError = () => { error.hidden = true; error.textContent = ''; };
    const showError = (message: string) => { error.textContent = message; error.hidden = false; };
    const showStatus = (message: string) => { status.textContent = message; status.hidden = false; };
    const clearStatus = () => { status.hidden = true; status.textContent = ''; };
    const revoke = (url: string | undefined) => { if (url) URL.revokeObjectURL(url); };
    const currentMode = () => root.querySelector<HTMLInputElement>('[data-resize-mode]:checked')?.value ?? 'dimensions';

    const resetResult = () => {
      revoke(resultUrl);
      resultUrl = undefined;
      for (const url of itemUrls) URL.revokeObjectURL(url);
      itemUrls = [];
      result.hidden = true;
      resultFigure.hidden = false;
      resultDl.hidden = false;
      resultSummary.hidden = true;
      resultSummary.textContent = '';
      resultList.hidden = true;
      resultList.replaceChildren();
      resultImage.removeAttribute('src');
      download.removeAttribute('href');
      download.removeAttribute('download');
    };

    const resetTool = () => {
      releaseBatch(sources);
      sources = [];
      sourceDimensions = undefined;
      fileInput.value = '';
      resetResult();
      previewImage.removeAttribute('src');
      batchNote.hidden = true;
      dropZone.hidden = false;
      editor.hidden = true;
      clearError();
      clearStatus();
    };

    /** What the panel is asking for, in a form every picture can answer. */
    const currentRequest = (): BatchResizeRequest =>
      currentMode() === 'percentage'
        ? { mode: 'percentage', percentage: Number(percentageInput.value) }
        : {
            mode: 'dimensions',
            width: Number(widthInput.value),
            height: Number(heightInput.value),
            keepProportions: aspectLock.checked,
          };

    const getRequestedDimensions = (source = sourceDimensions): ImageDimensions | undefined =>
      source ? getBatchResizeDimensions(source, currentRequest()) : undefined;

    const updateDimensionPreview = () => {
      const dimensions = getRequestedDimensions();
      const validation = dimensions && validateResizeDimensions(dimensions);
      const many = sources.length > 1;

      dimensionPreview.textContent = dimensions && !validation
        ? `${dimensions.width} × ${dimensions.height} px${many ? ' (first image)' : ''}`
        : 'Enter valid dimensions';

      // What one set of numbers means to a set of pictures, said rather than
      // left to be discovered in the downloads folder.
      batchNote.hidden = !many;
      batchNote.textContent = !many
        ? ''
        : currentMode() === 'percentage'
          ? `Every one of the ${describeBatchCount(sources.length)} is scaled by this percentage.`
          : aspectLock.checked
            ? `Every one of the ${describeBatchCount(sources.length)} is set to this width and keeps its own proportions.`
            : `Every one of the ${describeBatchCount(sources.length)} is forced to exactly these dimensions.`;
    };

    const updateMode = () => {
      const usesPercentage = currentMode() === 'percentage';
      dimensionFields.hidden = usesPercentage;
      percentageFields.hidden = !usesPercentage;
      updateDimensionPreview();
    };

    const selectFiles = async (chosen: readonly File[]) => {
      resetTool();
      if (chosen.length === 0) return;

      const problem = validateBatchSelection(chosen);
      if (problem) {
        showError(chosen.length === 1 ? 'Choose a JPEG, PNG, WebP, AVIF, or BMP image.' : problem);
        return;
      }

      dropZone.hidden = true;
      showStatus(chosen.length === 1 ? 'Reading image dimensions…' : `Reading ${describeBatchCount(chosen.length)} locally…`);
      await nextPaint();

      const { sources: read, failures } = await readBatchSources(chosen, (position, total) => {
        if (total > 1) showStatus(`Reading image ${position} of ${total} locally…`);
      });

      // A file that will not decode is one row lost, not the whole batch — but
      // a batch where nothing decoded is an error like any other.
      if (read.length === 0) {
        releaseBatch(read);
        dropZone.hidden = false;
        clearStatus();
        showError(failures[0]?.reason ?? 'This image could not be read.');
        return;
      }

      const tooMuch = checkBatchSize(read);
      if (tooMuch) {
        releaseBatch(read);
        dropZone.hidden = false;
        clearStatus();
        showError(tooMuch);
        return;
      }

      sources = read;

      const [first] = sources;

      sourceDimensions = { width: first.width, height: first.height };
      previewImage.src = first.previewUrl;
      inputName.textContent = sources.length === 1
        ? `${first.file.name} · ${first.width} × ${first.height} px`
        : `${describeBatchCount(sources.length)} · first: ${first.file.name} · ${first.width} × ${first.height} px`;
      widthInput.value = String(first.width);
      heightInput.value = String(first.height);
      percentageInput.value = '100';
      outputFormat.value = getPreferredOutputFormat(getInputImageFormat(first.file));
      resizeButton.textContent = sources.length === 1 ? 'Resize it' : `Resize ${describeBatchCount(sources.length)}`;
      updateDimensionPreview();
      clearStatus();
      editor.hidden = false;

      if (failures.length > 0) {
        showError(`${failures.length} of the chosen files could not be read: ${failures.map((failure) => failure.name).join(', ')}.`);
      }
    };

    /** One finished row: the file, and the line the list shows beside it. */
    const renderRow = (file: File, detail: string, thumbnail: string) => {
      const fragment = resultItemTemplate.content.cloneNode(true) as DocumentFragment;
      const image = fragment.querySelector<HTMLImageElement>('[data-item-image]');
      const name = fragment.querySelector<HTMLElement>('[data-item-name]');
      const link = fragment.querySelector<HTMLAnchorElement>('[data-item-download]');

      if (image) image.src = thumbnail;
      if (name) name.textContent = `${file.name} · ${detail}`;
      if (link) {
        link.href = thumbnail;
        link.download = file.name;
        link.setAttribute('aria-label', `Download ${file.name}`);
      }

      return fragment;
    };

    const renderFailure = (failure: { readonly name: string; readonly reason: string }) => {
      const fragment = failureItemTemplate.content.cloneNode(true) as DocumentFragment;
      const name = fragment.querySelector<HTMLElement>('[data-item-name]');
      const reason = fragment.querySelector<HTMLElement>('[data-item-reason]');

      if (name) name.textContent = failure.name;
      if (reason) reason.textContent = failure.reason;

      return fragment;
    };

    const resizeImages = async () => {
      if (sources.length === 0 || !sourceDimensions || !isImageOutputFormat(outputFormat.value)) return;

      // The numbers are checked against every picture before any of them is
      // resized: a batch that stops halfway because the fifth picture would
      // come out too large is a batch nobody can act on.
      const planned = sources.map((source) => getRequestedDimensions(source));
      const invalid = planned.find((dimensions) => !dimensions || validateResizeDimensions(dimensions));

      if (planned.some((dimensions) => !dimensions) || invalid) {
        showError((invalid && validateResizeDimensions(invalid)) ?? 'Enter valid dimensions before resizing.');
        return;
      }

      const format = outputFormat.value;
      const many = sources.length > 1;

      clearError();
      resetResult();
      resizeButton.disabled = true;
      resizeButton.textContent = 'Resizing…';
      showStatus(many
        ? `Resizing ${describeBatchCount(sources.length)} locally…`
        : isLargeImage(sourceDimensions) ? 'Large image: resizing locally…' : 'Resizing locally…');
      await nextPaint();

      try {
        const outcomes = await runImageBatch(
          sources,
          async (source) => {
            const dimensions = getRequestedDimensions(source);

            if (!dimensions) throw new Error('This image could not be resized to those dimensions.');

            const blob = await encodeBrowserImage(source.image, dimensions, format);

            return {
              file: new File([blob], getResizeOutputFilename(source.file.name, format), { type: blob.type }),
              source: { width: source.width, height: source.height },
              dimensions,
            };
          },
          (position, total) => {
            if (total > 1) showStatus(`Resizing image ${position} of ${total} locally…`);
          },
        );
        const outputs = getBatchSuccesses(outcomes);
        const failures = getBatchFailures(outcomes);

        if (!hasBatchOutput(outcomes)) {
          throw new Error(failures[0]?.reason ?? 'This image could not be resized.');
        }

        editor.hidden = true;
        result.hidden = false;

        if (!many) {
          const [output] = outputs;

          resultUrl = URL.createObjectURL(output.file);
          resultTitle.textContent = 'Right size. Ready to go.';
          originalDimensions.textContent = `${output.source.width} × ${output.source.height} px`;
          resultDimensions.textContent = `${output.dimensions.width} × ${output.dimensions.height} px`;
          resultImage.src = resultUrl;
          download.href = resultUrl;
          download.download = output.file.name;
          download.textContent = 'Download image';
          return;
        }

        // A batch hands back one archive and the rows it was packed from, so a
        // visitor can take the lot or just the one they wanted.
        itemUrls = outputs.map((output) => URL.createObjectURL(output.file));
        resultFigure.hidden = true;
        resultDl.hidden = true;
        resultList.hidden = false;
        resultList.replaceChildren(
          ...outputs.map((output, index) =>
            renderRow(
              output.file,
              `${output.dimensions.width} × ${output.dimensions.height} px · ${formatFileSize(output.file.size)}`,
              itemUrls[index],
            ),
          ),
          ...failures.map(renderFailure),
        );

        const archive = await packImageArchive(outputs.map((output) => output.file));
        const bytes = outputs.reduce((total, output) => total + output.file.size, 0);

        resultUrl = URL.createObjectURL(archive);
        resultTitle.textContent = 'Right size. Ready to go.';
        resultSummary.hidden = false;
        resultSummary.textContent = summariseBatch(outcomes, bytes);
        download.href = resultUrl;
        download.download = getBatchArchiveName('resized');
        download.textContent = `Download all ${outputs.length} as a ZIP`;
      } catch (caughtError) {
        showError(caughtError instanceof Error ? caughtError.message : 'This image could not be resized.');
      } finally {
        clearStatus();
        resizeButton.disabled = false;
        resizeButton.textContent = sources.length > 1 ? `Resize ${describeBatchCount(sources.length)}` : 'Resize it';
      }
    };

    selectFileButton.addEventListener('click', () => fileInput.click());
    fileInput.addEventListener('change', () => void selectFiles([...(fileInput.files ?? [])]));
    clearButton.addEventListener('click', resetTool);
    resultClearButton.addEventListener('click', resetTool);
    resizeButton.addEventListener('click', () => void resizeImages());
    resizeModes.forEach((mode) => mode.addEventListener('change', updateMode));
    widthInput.addEventListener('input', () => {
      if (aspectLock.checked && sourceDimensions && Number(widthInput.value) > 0) heightInput.value = String(dimensionsFromWidth(sourceDimensions, Number(widthInput.value)).height);
      updateDimensionPreview();
    });
    heightInput.addEventListener('input', () => {
      if (aspectLock.checked && sourceDimensions && Number(heightInput.value) > 0) widthInput.value = String(dimensionsFromHeight(sourceDimensions, Number(heightInput.value)).width);
      updateDimensionPreview();
    });
    percentageInput.addEventListener('input', updateDimensionPreview);
    aspectLock.addEventListener('change', updateDimensionPreview);
    for (const eventName of ['dragenter', 'dragover']) dropZone.addEventListener(eventName, (event) => { event.preventDefault(); dropZone.dataset.dragging = 'true'; });
    for (const eventName of ['dragleave', 'drop']) dropZone.addEventListener(eventName, (event) => { event.preventDefault(); delete dropZone.dataset.dragging; });
    dropZone.addEventListener('drop', (event) => void selectFiles([...(event.dataTransfer?.files ?? [])]));
    updateMode();
  }
</script>
