---
import PdfViewerSurface from './PdfViewerSurface.astro';
---

<section class="pdf-viewer-tool" data-pdf-viewer-tool>
  <div class="pdf-viewer-tool__picker" data-drop-zone>
    <input
      id="pdf-viewer-file"
      class="pdf-viewer-tool__file-input"
      type="file"
      accept="application/pdf,.pdf"
      aria-label="Select a PDF to open"
      data-file-input
      hidden
    />
    <p class="metadata">One PDF at a time</p>
    <h2>Drop a PDF here</h2>
    <p>It is read and drawn by this browser. Nothing is uploaded.</p>
    <button type="button" class="button-secondary" data-select-file>Choose a PDF</button>
  </div>

  <p class="pdf-viewer-tool__status" data-status role="status" aria-live="polite" hidden></p>
  <p class="pdf-viewer-tool__error" data-error role="alert" hidden></p>

  <div class="pdf-viewer-tool__reader" data-reader hidden>
    <!-- The whole reading workspace is the shared surface: after the
      extraction this Gizlet is the surface plus a file picker, which is what
      makes it the same viewer every other PDF Gizlet embeds. -->
    <div class="pdf-viewer-tool__surface" data-surface-host>
      <PdfViewerSurface id="pdf-viewer" label="PDF reader" thumbnails zoom />
    </div>

    <div class="pdf-viewer-tool__actions">
      <button type="button" class="button-secondary" data-clear>Open another PDF</button>
    </div>
  </div>
</section>

<style>
  .pdf-viewer-tool { border: var(--border-strong-width) solid var(--text); background: var(--surface); }
  .pdf-viewer-tool__picker { padding: var(--space-5); border: 2px dashed var(--border); text-align: center; }
  .pdf-viewer-tool__picker[data-dragging='true'] { border-color: var(--color-amber); background: color-mix(in srgb, var(--color-amber) 12%, var(--surface)); }
  .pdf-viewer-tool__picker[hidden], .pdf-viewer-tool__reader[hidden] { display: none; }
  .pdf-viewer-tool__picker h2 { margin-bottom: var(--space-2); }
  .pdf-viewer-tool__picker p:not(.metadata) { margin-bottom: var(--space-4); color: var(--text-muted); }
  .pdf-viewer-tool__status, .pdf-viewer-tool__error { margin: var(--space-3); padding: var(--space-3); border-left: var(--border-strong-width) solid var(--success); color: var(--text-muted); }
  .pdf-viewer-tool__error { border-left-color: var(--color-red); color: var(--color-red); }
  .pdf-viewer-tool__reader { display: grid; gap: var(--space-3); padding: var(--space-4); border-top: var(--border-width) solid var(--border); }
  .pdf-viewer-tool__actions { display: flex; flex-wrap: wrap; gap: var(--space-2); padding-top: var(--space-3); border-top: var(--border-width) solid var(--border); }
  @media (max-width: 36rem) {
    .pdf-viewer-tool__picker, .pdf-viewer-tool__reader { padding: var(--space-3); }
  }
</style>

<script>
  import { formatFileSize } from '../data/image-compression';
  import {
    isLargePdfViewerDocument,
    validatePdfFileSelection,
    validatePdfPageCount,
  } from '../data/pdf-viewer';
  import { createPdfViewerSurface } from '../scripts/pdf-viewer-surface';

  const root = document.querySelector<HTMLElement>('[data-pdf-viewer-tool]');

  if (root) {
    const fileInput = root.querySelector<HTMLInputElement>('[data-file-input]');
    const selectFileButton = root.querySelector<HTMLButtonElement>('[data-select-file]');
    const dropZone = root.querySelector<HTMLElement>('[data-drop-zone]');
    const status = root.querySelector<HTMLElement>('[data-status]');
    const error = root.querySelector<HTMLElement>('[data-error]');
    const reader = root.querySelector<HTMLElement>('[data-reader]');
    const surfaceRoot = root.querySelector<HTMLElement>('[data-pdf-surface]');
    const clearButton = root.querySelector<HTMLButtonElement>('[data-clear]');

    if (!fileInput || !selectFileButton || !dropZone || !status || !error || !reader || !surfaceRoot || !clearButton) {
      throw new Error('PDF Viewer tool could not initialise.');
    }

    const surface = createPdfViewerSurface(surfaceRoot);

    const nextPaint = () => new Promise<void>((resolve) => requestAnimationFrame(() => requestAnimationFrame(() => resolve())));
    const clearError = () => { error.hidden = true; error.textContent = ''; };
    const showError = (message: string) => { error.textContent = message; error.hidden = false; };
    const showStatus = (message: string) => { status.textContent = message; status.hidden = false; };
    const clearStatus = () => { status.hidden = true; status.textContent = ''; };

    const resetTool = () => {
      surface.reset();
      fileInput.value = '';
      reader.hidden = true;
      dropZone.hidden = false;
      clearError();
      clearStatus();
    };

    const openFile = async (file: File | undefined) => {
      resetTool();
      if (!file) return;

      const problem = validatePdfFileSelection([file]);
      if (problem) {
        showError(problem);
        return;
      }

      dropZone.hidden = true;
      showStatus('Reading the PDF locally…');
      await nextPaint();

      try {
        // pdf.js arrives only once a document is actually being opened, which
        // is why this page loads without a megabyte of renderer.
        const { openLocalPdf } = await import('../scripts/pdf-rendering');
        const opened = await openLocalPdf(file);
        const countProblem = validatePdfPageCount(opened.pageCount);

        if (countProblem) {
          await opened.close().catch(() => undefined);
          throw new Error(countProblem);
        }

        const pageCount = opened.pageCount;

        reader.hidden = false;

        if (isLargePdfViewerDocument(pageCount)) {
          showStatus(`Large document: drawing ${pageCount} page thumbnails locally…`);
        } else {
          clearStatus();
        }

        await surface.show(
          opened,
          `${file.name} · ${formatFileSize(file.size)} · ${pageCount} ${pageCount === 1 ? 'page' : 'pages'}`,
        );
        clearStatus();
      } catch (caughtError) {
        reader.hidden = true;
        dropZone.hidden = false;
        clearStatus();
        showError(caughtError instanceof Error ? caughtError.message : 'This PDF could not be opened.');
      }
    };

    selectFileButton.addEventListener('click', () => fileInput.click());
    fileInput.addEventListener('change', () => void openFile(fileInput.files?.[0]));
    clearButton.addEventListener('click', resetTool);
    for (const eventName of ['dragenter', 'dragover']) {
      dropZone.addEventListener(eventName, (event) => { event.preventDefault(); dropZone.dataset.dragging = 'true'; });
    }
    for (const eventName of ['dragleave', 'drop']) {
      dropZone.addEventListener(eventName, (event) => { event.preventDefault(); delete dropZone.dataset.dragging; });
    }
    dropZone.addEventListener('drop', (event) => void openFile(event.dataTransfer?.files[0]));
  }
</script>
