---
const navigationItems = [
  { href: '/tools/', label: 'Tools' },
  { href: '/flows/', label: 'Flows' },
  { href: '/request-a-gizlet/', label: 'Request a Gizlet' },
];
---

<header class="site-header">
  <div class="site-container site-header__inner">
    <a class="site-logo" href="/" aria-label="Gizlet home">
      <img class="site-logo__light" src="/brand/gizlet-logo.svg" alt="" width="160" height="48" />
      <img
        class="site-logo__dark"
        src="/brand/gizlet-logo-dark.svg"
        alt=""
        width="160"
        height="48"
      />
    </a>

    <nav class="site-navigation" aria-label="Primary navigation">
      <ul>
        {
          navigationItems.map(({ href, label }) => (
            <li><a href={href}>{label}</a></li>
          ))
        }
      </ul>
    </nav>

    <div class="site-header__actions">
      <button
        class="site-header__control"
        type="button"
        aria-label="Search Gizlet"
        aria-haspopup="dialog"
        aria-controls="tool-search-overlay"
        aria-expanded="false"
        aria-keyshortcuts="Control+K Meta+K"
        data-search-open
      >
        <span>Search</span>
        <span class="site-header__shortcut" aria-hidden="true">⌘K / Ctrl K</span>
      </button>
      <button
        class="site-header__control"
        type="button"
        data-theme-toggle
        aria-label="Choose color theme"
        aria-pressed="false"
      >
        <span class="site-header__theme-label site-header__theme-label--light">Dark</span>
        <span class="site-header__theme-label site-header__theme-label--dark">Light</span>
      </button>
    </div>
  </div>
</header>

<script>
  import { initializeThemeToggle } from '../scripts/theme';

  initializeThemeToggle();
</script>

<style>
  .site-header {
    border-bottom: var(--border-width) solid var(--border);
  }

  .site-header__inner {
    display: flex;
    min-height: 5rem;
    align-items: center;
    gap: var(--space-4);
  }

  .site-logo {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    color: inherit;
    line-height: 0;
  }

  .site-logo:hover {
    color: inherit;
  }

  .site-logo img {
    width: 10rem;
    height: auto;
  }

  .site-logo__dark {
    display: none;
  }

  @media (prefers-color-scheme: dark) {
    .site-logo__light {
      display: none;
    }

    .site-logo__dark {
      display: block;
    }
  }

  :global(:root[data-theme='light']) .site-logo__light {
    display: block;
  }

  :global(:root[data-theme='light']) .site-logo__dark,
  :global(:root[data-theme='dark']) .site-logo__light {
    display: none;
  }

  :global(:root[data-theme='dark']) .site-logo__dark {
    display: block;
  }

  .site-navigation {
    margin-right: auto;
  }

  .site-navigation ul,
  .site-header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .site-navigation ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-navigation a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    color: var(--text);
    font-weight: 700;
    text-decoration: none;
  }

  .site-navigation a:hover {
    color: var(--link);
    text-decoration: underline;
    text-decoration-thickness: 2px;
  }

  .site-header__control {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-width: 2.75rem;
    border-color: var(--text);
    background: transparent;
    color: var(--text);
  }

  /*
    The label follows the theme in CSS rather than from the toggle script, so the
    first paint already shows the resolved theme. Writing it from script instead
    resized the button after hydration and shifted the whole page on narrow screens.
  */
  .site-header__theme-label--dark {
    display: none;
  }

  @media (prefers-color-scheme: dark) {
    .site-header__theme-label--light {
      display: none;
    }

    .site-header__theme-label--dark {
      display: inline;
    }
  }

  :global(:root[data-theme='light']) .site-header__theme-label--light {
    display: inline;
  }

  :global(:root[data-theme='light']) .site-header__theme-label--dark,
  :global(:root[data-theme='dark']) .site-header__theme-label--light {
    display: none;
  }

  :global(:root[data-theme='dark']) .site-header__theme-label--dark {
    display: inline;
  }

  @media (max-width: 44rem) {
    .site-header__inner {
      min-height: 0;
      flex-wrap: wrap;
      gap: var(--space-2) var(--space-3);
      padding-top: var(--space-3);
      padding-bottom: var(--space-3);
    }

    .site-logo {
      margin-right: auto;
    }

    .site-navigation {
      order: 3;
      width: 100%;
      margin-right: 0;
    }

    .site-navigation ul {
      justify-content: space-between;
    }

    .site-navigation li {
      flex: 1;
    }

    .site-navigation a {
      width: 100%;
    }

    .site-header__actions {
      gap: var(--space-2);
    }

    .site-header__control {
      padding-right: var(--space-2);
      padding-left: var(--space-2);
    }

    .site-header__shortcut {
      display: none;
    }
  }

  .site-header__shortcut {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    font-weight: 400;
    white-space: nowrap;
  }
</style>
