---
import type { AdvertisementRailSize, AdvertisementSlotVariant } from '../data/advertisement-slots';
import { getAdvertisementConfiguration, getPageAdvertisementPolicy } from '../data/advertising';
import { getToolMetadata } from '../data/metadata';
import {
  getContentSectionId,
  getToolContentSections,
  getToolPageContent,
} from '../data/tool-page-content';
import { getToolProcessingStatus } from '../data/tool-page-status';
import { getToolStructuredData } from '../data/structured-data';
import type { ToolRegistryEntry } from '../data/tools';
import BaseLayout from '../layouts/BaseLayout.astro';
import AdvertisementSlot from './AdvertisementSlot.astro';

interface Props {
  tool: ToolRegistryEntry;
  relatedTools?: readonly ToolRegistryEntry[];
  processingStatus?: string;
  showPostResultAd?: boolean;
  showRail?: boolean;
  railSize?: AdvertisementRailSize;
  description?: string;
  image?: string;
  robots?: string;
  title?: string;
}

const {
  tool,
  relatedTools = [],
  processingStatus,
  showPostResultAd = false,
  showRail = false,
  railSize = 'standard',
  description,
  image,
  robots,
  title,
} = Astro.props;
const status = getToolProcessingStatus(tool, processingStatus);
const content = getToolPageContent(tool);
const metadata = getToolMetadata(tool, { title, description, image, robots });
const requestedSlots: AdvertisementSlotVariant[] = [
  ...(showPostResultAd ? ['inline' as const] : []),
  ...(showRail ? ['rail' as const] : []),
];
const advertising = getPageAdvertisementPolicy({
  pathname: tool.path,
  configuration: getAdvertisementConfiguration({
    isDevelopment: import.meta.env.DEV,
    enabled: import.meta.env.PUBLIC_ADS_ENABLED,
    adSenseClient: import.meta.env.PUBLIC_ADSENSE_CLIENT,
    bannerSlot: import.meta.env.PUBLIC_ADSENSE_BANNER_SLOT,
    inlineSlot: import.meta.env.PUBLIC_ADSENSE_INLINE_SLOT,
    railSlot: import.meta.env.PUBLIC_ADSENSE_RAIL_SLOT,
  }),
  requestedSlots,
  isAvailableTool: tool.launchStatus === 'available',
});
const shouldShowPostResultAd = showPostResultAd && advertising.enabled && advertising.slots.inline;
const shouldShowRail = showRail && advertising.enabled && advertising.slots.rail;
---

<BaseLayout advertising={advertising} metadata={metadata} structuredData={getToolStructuredData(tool)}>
  <article class="tool-page">
    <nav class="tool-page__breadcrumb" aria-label="Breadcrumb">
      <ol>
        <li><a href="/">Gizlet</a></li>
        <li><a href="/tools/">Tools</a></li>
        <li aria-current="page">{tool.name}</li>
      </ol>
    </nav>

    <header class="tool-page__header">
      <p class="metadata">{tool.category}</p>
      <h1>{tool.name}</h1>
      <p>{tool.description}</p>

      {
        status && (
          <div
            class:list={['tool-page__processing-status', { 'tool-page__processing-status--local': status.isLocal }]}
            aria-label={status.label}
          >
            <p class="metadata">{status.label}</p>
            <p>{status.description}</p>
          </div>
        )
      }
    </header>

    <div class:list={['tool-page__body', { 'tool-page__body--with-rail': shouldShowRail }]}>
      <div class="tool-page__main-column">
        <section class="tool-page__workspace" aria-label={`${tool.name} workspace`}>
          <slot name="workspace" />
        </section>

        <p class="tool-page__handoff" data-handoff-note role="status" hidden></p>

        <slot name="result" />

        {shouldShowPostResultAd && <AdvertisementSlot advertising={advertising} variant="inline" />}
      </div>

      {shouldShowRail && <AdvertisementSlot advertising={advertising} variant="rail" railSize={railSize} />}
    </div>

    {
      content && (
        <div class="tool-page__about">
          {getToolContentSections(content).map((section) => (
            <section class="tool-page__about-section" aria-labelledby={getContentSectionId(section)}>
              <h2 id={getContentSectionId(section)}>{section.heading}</h2>
              {section.paragraphs.map((paragraph) => (
                <p>{paragraph}</p>
              ))}
              {section.details && section.details.length > 0 && (
                <dl class="tool-page__about-details">
                  {section.details.map((detail) => (
                    <>
                      <dt>{detail.term}</dt>
                      <dd>{detail.description}</dd>
                    </>
                  ))}
                </dl>
              )}
            </section>
          ))}

          <section class="tool-page__faq" aria-labelledby="tool-faq-title">
            <h2 id="tool-faq-title">Common questions about {tool.name}</h2>
            {content.faq.map((entry) => (
              <div class="tool-page__faq-entry">
                <h3>{entry.question}</h3>
                <p>{entry.answer}</p>
              </div>
            ))}
          </section>
        </div>
      )
    }

    {
      relatedTools.length > 0 && (
        <section class="tool-page__related" aria-labelledby="related-gizlets-title">
          <div class="tool-page__section-heading">
            <p class="metadata">Keep going</p>
            <h2 id="related-gizlets-title">Related Gizlets</h2>
          </div>
          <ul>
            {relatedTools.map((relatedTool) => (
              <li>
                <a href={relatedTool.path}>
                  <span>
                    <strong>{relatedTool.name}</strong>
                    <span>{relatedTool.description}</span>
                  </span>
                  {relatedTool.processesLocally && <span class="status-local">Local</span>}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </article>
</BaseLayout>

<style>
  .tool-page {
    max-width: var(--container-width);
  }

  .tool-page__breadcrumb {
    margin-bottom: var(--space-5);
  }

  .tool-page__breadcrumb ol {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    list-style: none;
  }

  .tool-page__breadcrumb li:not(:last-child)::after {
    margin-left: var(--space-1);
    content: '/';
  }

  .tool-page__header {
    max-width: 48rem;
  }

  .tool-page__header > .metadata {
    margin-bottom: var(--space-1);
  }

  .tool-page__header h1 {
    font-size: clamp(2.25rem, 5vw, 3.75rem);
  }

  .tool-page__header > p:not(.metadata) {
    max-width: 42rem;
    color: var(--text-muted);
    font-size: var(--font-size-lg);
  }

  .tool-page__processing-status {
    margin-top: var(--space-4);
    padding: var(--space-3);
    border-left: var(--border-strong-width) solid var(--border);
  }

  .tool-page__processing-status--local {
    border-left-color: var(--success);
  }

  .tool-page__processing-status .metadata {
    margin-bottom: var(--space-1);
  }

  .tool-page__processing-status--local .metadata {
    color: var(--success);
  }

  .tool-page__processing-status p:last-child {
    margin: 0;
  }

  .tool-page__body {
    margin-top: var(--space-6);
  }

  .tool-page__body--with-rail {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(16rem, 18.75rem);
    gap: var(--space-6);
    align-items: start;
  }

  .tool-page__workspace {
    min-width: 0;
  }

  .tool-page__main-column > :global(*) + :global(*) {
    margin-top: var(--space-5);
  }

  .tool-page__about {
    max-width: 44rem;
    margin-top: var(--space-7);
  }

  .tool-page__about-section + .tool-page__about-section,
  .tool-page__faq {
    margin-top: var(--space-6);
  }

  .tool-page__about h2 {
    padding-bottom: var(--space-1);
    border-bottom: var(--border-width) solid var(--border);
    font-size: var(--font-size-xl);
  }

  .tool-page__about p {
    color: var(--text-muted);
  }

  .tool-page__about-details {
    margin: 0;
  }

  .tool-page__about-details dt {
    margin-top: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .tool-page__about-details dd {
    margin: var(--space-1) 0 0;
    color: var(--text-muted);
  }

  .tool-page__faq-entry + .tool-page__faq-entry {
    margin-top: var(--space-4);
  }

  .tool-page__faq h3 {
    margin-bottom: var(--space-1);
    font-size: var(--font-size-lg);
  }

  .tool-page__faq p {
    margin: 0;
  }

  .tool-page__related {
    max-width: 48rem;
    margin-top: var(--space-7);
  }

  .tool-page__section-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }

  .tool-page__section-heading .metadata,
  .tool-page__section-heading h2 {
    margin: 0;
  }

  .tool-page__related ul {
    margin: 0;
    padding: 0;
    border-top: var(--border-width) solid var(--border);
    list-style: none;
  }

  .tool-page__related li {
    border-bottom: var(--border-width) solid var(--border);
  }

  .tool-page__related a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    min-height: 3.5rem;
    padding: var(--space-2);
    color: var(--text);
    text-decoration: none;
  }

  .tool-page__related a:hover {
    background: var(--surface);
  }

  .tool-page__related a > span:first-child {
    display: grid;
    gap: var(--space-1);
  }

  .tool-page__related strong {
    font-family: var(--font-display);
    font-size: var(--font-size-lg);
  }

  .tool-page__related a > span:first-child span {
    color: var(--text-muted);
  }

  .tool-page__handoff {
    margin: var(--space-3) 0 0;
    padding: var(--space-2) var(--space-3);
    border-left: var(--border-strong-width) solid var(--success);
    color: var(--text-muted);
    font-size: var(--font-size-sm);
  }

  .tool-page__handoff[hidden] {
    display: none;
  }

  @media (max-width: 56rem) {
    .tool-page__body--with-rail {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

<script>
  import { readHandoffId } from '../data/file-handoff';

  /**
   * A file chosen on another page of this site, put into this workspace's own
   * picker.
   *
   * It goes in through the file input rather than through each workspace's
   * internals: every workspace already reads its picker and reacts to it
   * changing, so one script here works for all of them and no Gizlet needs to
   * know that a handoff exists. The fragment is cleared afterwards, so a reload
   * is an ordinary page load rather than a second attempt at a record that has
   * already been read and deleted.
   */
  const handoffId = readHandoffId(window.location.hash);

  if (handoffId) {
    const note = document.querySelector<HTMLElement>('[data-handoff-note]');
    const input = document.querySelector<HTMLInputElement>('[data-file-input]:not([data-handoff-skip])');

    void (async () => {
      history.replaceState(null, '', `${window.location.pathname}${window.location.search}`);

      if (!input) return;

      const { takeHandoffFile } = await import('../scripts/file-handoff');
      const file = await takeHandoffFile(handoffId);

      if (!file) return;

      try {
        const transfer = new DataTransfer();

        transfer.items.add(file);
        input.files = transfer.files;
        input.dispatchEvent(new Event('change', { bubbles: true }));

        if (note) {
          note.textContent = `${file.name} came with you from the file you dropped. It never left this device.`;
          note.hidden = false;
        }
      } catch {
        // A browser that will not let a file be put into a picker leaves the
        // workspace exactly as it would have been: empty, and waiting.
      }
    })();
  }
</script>
