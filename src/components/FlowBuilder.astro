      if (setting === 'resolution' && isPdfImageResolution(target.value)) step.resolution = target.value;
      if (setting === 'ratio' && isFlowCropAspectRatioName(target.value)) step.ratio = target.value;
      if (setting === 'layout' && isCollageLayoutName(target.value)) step.layout = target.value;
      if (setting === 'turn' && isOrientationPresetName(target.value)) step.turn = target.value;
      if (setting === 'pageTurn' && isPdfPageTurn(target.value)) step.pageTurn = target.value;
      if (setting === 'word' && isWatermarkWord(target.value)) step.word = target.value;
      if (setting === 'markPosition' && isWatermarkPosition(target.value)) step.markPosition = target.value;
      if (setting === 'numberFormat' && isPageNumberFormat(target.value)) step.numberFormat = target.value;
      if (setting === 'numberPosition' && isPageNumberPosition(target.value)) step.numberPosition = target.value;
      if (setting === 'strength') {
        step.strength = Number(target.value);
        const output = stepList.querySelector<HTMLOutputElement>(`[data-strength-output="${step.id}"]`);
        if (output) output.textContent = `${step.strength}%`;
