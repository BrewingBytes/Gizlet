        resultList.hidden = false;
        download.textContent = fromDocument
          ? `Download all ${payloads.length} pages`
          : `Download all ${payloads.length} as a ZIP`;
        download.href = resultUrl;
        download.download = outcome.archiveName;
        result.hidden = false;
        showStatus('Done. Your images are ready to download.');
      } else {
        const output = outcome.payload;
        resultUrl = URL.createObjectURL(output.file);
        resultImage.src = resultUrl;
        resultDetails.textContent = `${getFormatLabel(outputFormat)} · ${output.width} × ${output.height} px · ${formatFileSize(output.file.size)}`;
        download.href = resultUrl;
        download.download = output.file.name;
        result.hidden = false;
        showStatus('Done. Your final image is ready to download.');
      }
    };
    const runFlow = async () => {
      if (sources.length === 0 || steps.length === 0 || isRunning) return;
      clearError();
      resetResult();

      // Taken after the reset, which would otherwise abort the run it starts.
      const run = new AbortController();
      activeRun = run;
      let ended: FlowRunPhase = 'failure';

      try {
        const outcome = await runFlowSteps(snapshotFlowRun({ steps, sources, outputFormat }), {
          signal: run.signal,
          onProgress: async (message) => {
            showStatus(message);
            await nextFrame();
          },
          // The page stays running until the result is drawn, preview and
          // all, so only the phases before an outcome are shown as they come.
          onPhase: (phase) => {
            if (phase === 'pending' || phase === 'running') showRunPhase(phase);
          },
        });

        ended = outcome.status;

        if (outcome.status === 'success') {
          await showResult(outcome.result, run.signal);

          // A panel cleared while the result was still being drawn — a PDF's
          // preview, say — stopped the run after it succeeded. Whatever it
          // was saying it was doing, it is no longer doing.
          if (run.signal.aborted) {
            ended = 'cancelled';
            clearStatus();
          }
        } else if (outcome.status === 'failure') {
          showError(outcome.message);
          clearStatus();
        } else {
          // Whatever stopped it already cleared the panel; a stopped run only
          // has to stop saying it is running.
          clearStatus();
        }
      } catch (caughtError) {
        showError(caughtError instanceof Error ? caughtError.message : 'This flow could not be processed. Try another image or adjust the step settings.');
        clearStatus();
      } finally {
        if (activeRun === run) activeRun = undefined;
        showRunPhase(ended);
      }
    };

    sourceSelect.addEventListener('click', () => sourceInput.click());
    sourceInput.addEventListener('change', () => void addSources([...(sourceInput.files ?? [])]));
    sourceClear.addEventListener('click', clearSources);
    sourceList.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-source-action]');
      if (!button || isRunning) return;

      const id = Number(button.dataset.sourceId);
      const index = sources.findIndex((source) => source.id === id);
      if (index === -1) return;

      if (button.dataset.sourceAction === 'up') sources = reorderPdfImages(sources, index, index - 1);
      if (button.dataset.sourceAction === 'down') sources = reorderPdfImages(sources, index, index + 1);
      if (button.dataset.sourceAction === 'remove') {
        releaseSource(sources[index]);
        sources = sources.filter((source) => source.id !== id);
      }

      resetResult();
      clearError();
      renderSteps();
    });
    categorySelect.addEventListener('change', () => {
      const chosen = categorySelect.value;

      if (!isFlowCategoryId(chosen) || chosen === categoryId || isRunning) {
        categorySelect.value = categoryId;
        return;
      }

      categoryId = chosen;

      // A chain built for one starting payload cannot read another, and a
      // half-kept chain would be a flow the visitor did not assemble. The
      // sources go with it: they are files of the wrong kind now.
      for (const source of sources) releaseSource(source);
      sources = [];
      steps = [];
      sourceInput.value = '';
      outputFormatFromRecipe = false;
      resetResult();
      clearError();
      clearStatus();
      categorySummary.textContent = category().summary;
      renderSteps();
    });
    finalFormat.addEventListener('change', () => {
      outputFormat = finalFormat.value as ImageOutputFormat;
      resetResult();
      renderSteps();
    });
    addStepButton.addEventListener('click', () => {
      const toolSlug = addSelect.value;
      if (!isAvailableFlowToolSlug(toolSlug) || !availableStepSlugs().includes(toolSlug)) return;
      if (!isValidFlowSequence(flowInput(), [...stepSlugs(), toolSlug])) return;
      steps.push(defaultStep(toolSlug));
      resetResult();
      clearStatus();
      renderSteps();
    });
    stepList.addEventListener('input', (event) => {
      const target = event.target;
      if (target instanceof HTMLInputElement || target instanceof HTMLSelectElement) updateStepSetting(target);
    });
    stepList.addEventListener('change', (event) => {
      const target = event.target;
      if (target instanceof HTMLInputElement || target instanceof HTMLSelectElement) updateStepSetting(target);
    });
    stepList.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-step-action]');
      if (!button || isRunning) return;
      const id = Number(button.dataset.stepId);
      const index = steps.findIndex((step) => step.id === id);
      if (index === -1) return;
      if (button.dataset.stepAction === 'remove') steps.splice(index, 1);
      if (button.dataset.stepAction === 'up' && index > 0 && canReorder(index, index - 1)) [steps[index - 1], steps[index]] = [steps[index], steps[index - 1]];
      if (button.dataset.stepAction === 'down' && index < steps.length - 1 && canReorder(index, index + 1)) [steps[index], steps[index + 1]] = [steps[index + 1], steps[index]];
      resetResult();
      clearStatus();
      applySourceLimit();
      renderSteps();
    });
    const currentRecipe = (): Recipe => ({
      category: categoryId,
      // A format the chain has no control for is a format it would ignore, and
      // a shared link should not carry a setting its own page does not show.
      outputFormat: formatControl().kind === 'none' ? undefined : outputFormat,
      steps: steps.map((step) => ({
        toolSlug: step.toolSlug,
        ...(step.toolSlug === 'resize-image' ? { width: step.width, height: step.height } : {}),
        ...(step.toolSlug === 'compress-image' ? { quality: step.quality } : {}),
        ...(step.toolSlug === 'crop-image' ? { ratio: step.ratio } : {}),
        ...(step.toolSlug === 'collage-maker' ? { layout: step.layout } : {}),
        ...(step.toolSlug === 'rotate-flip-image' ? { turn: step.turn } : {}),
        ...(step.toolSlug === 'image-background' ? { canvasWidth: step.canvasWidth, canvasHeight: step.canvasHeight, fit: step.fit } : {}),
        ...(step.toolSlug === 'jpg-to-pdf' ? { pageSize: step.pageSize, orientation: step.orientation } : {}),
        ...(step.toolSlug === 'pdf-to-jpg' ? { resolution: step.resolution } : {}),
        ...(step.toolSlug === 'organize-pdf' ? { pageTurn: step.pageTurn } : {}),
        ...(step.toolSlug === 'watermark-pdf' ? { word: step.word, markPosition: step.markPosition, strength: step.strength } : {}),
        ...(step.toolSlug === 'pdf-page-numbers' ? { numberFormat: step.numberFormat, numberPosition: step.numberPosition } : {}),
      })),
    });
    const applyRecipe = (recipe: Recipe) => {
      // The starting payload comes first: the chain below it was validated
      // against this category, and the chooser has to agree with it.
      if (recipe.category) {
        categoryId = recipe.category;
        categorySelect.value = categoryId;
        categorySummary.textContent = category().summary;
      }

      // Defaults come from defaultStep, so a step whose settings the recipe
      // omits behaves exactly like one added by hand.
      steps = recipe.steps.map((step) => ({
        ...defaultStep(step.toolSlug),
        ...(step.width !== undefined ? { width: step.width } : {}),
        ...(step.height !== undefined ? { height: step.height } : {}),
        ...(step.quality !== undefined ? { quality: step.quality } : {}),
        ...(step.ratio !== undefined ? { ratio: step.ratio } : {}),
        ...(step.layout !== undefined ? { layout: step.layout } : {}),
        ...(step.turn !== undefined ? { turn: step.turn } : {}),
        ...(step.canvasWidth !== undefined ? { canvasWidth: step.canvasWidth } : {}),
        ...(step.canvasHeight !== undefined ? { canvasHeight: step.canvasHeight } : {}),
        ...(step.fit !== undefined ? { fit: step.fit } : {}),
        ...(step.pageSize !== undefined ? { pageSize: step.pageSize } : {}),
        ...(step.orientation !== undefined ? { orientation: step.orientation } : {}),
        ...(step.resolution !== undefined ? { resolution: step.resolution } : {}),
        ...(step.pageTurn !== undefined ? { pageTurn: step.pageTurn } : {}),
        ...(step.word !== undefined ? { word: step.word } : {}),
        ...(step.markPosition !== undefined ? { markPosition: step.markPosition } : {}),
        ...(step.numberFormat !== undefined ? { numberFormat: step.numberFormat } : {}),
        ...(step.numberPosition !== undefined ? { numberPosition: step.numberPosition } : {}),
        ...(step.strength !== undefined ? { strength: step.strength } : {}),
      }));
      if (recipe.outputFormat) {
        // A link may name a format the chain cannot honour — every image flow
        // written before this release defaulted to WebP, and one ending in a
        // PDF now offers only the two formats a page embeds. Keeping the link
        // readable and moving the format is better than refusing the flow.
        outputFormat = getUsableFlowFormat(getFlowFormatControl(recipe.steps.map((step) => step.toolSlug)), recipe.outputFormat)
          ?? recipe.outputFormat;
        outputFormatFromRecipe = true;
      }
    };
    const copyRecipeLink = () => {
      const encoded = encodeRecipe(currentRecipe());

      if (!encoded) {
        recipeStatus.textContent = 'This flow is too long to share as a link.';
        return;
      }

      const link = `${window.location.origin}${window.location.pathname}${encoded}`;
      window.history.replaceState(null, '', encoded);

      if (!navigator.clipboard?.writeText) {
        recipeStatus.textContent = 'Copy is unavailable in this browser. The link is in the address bar.';
        return;
      }

      navigator.clipboard
        .writeText(link)
        .then(() => { recipeStatus.textContent = 'Recipe link copied. It carries these settings only, never your files.'; })
        .catch(() => { recipeStatus.textContent = 'Could not copy automatically. The link is in the address bar.'; });
    };

    resultClear.addEventListener('click', resetResult);
    runButton.addEventListener('click', () => void runFlow());
    copyRecipe.addEventListener('click', copyRecipeLink);

    // An unreadable recipe is ignored whole: the builder renders its default
    // state rather than a chain the visitor cannot tell is incomplete.
    const openedRecipe = decodeRecipe(window.location.hash);
    if (openedRecipe) applyRecipe(openedRecipe);

    renderSteps();
  }
</script>
