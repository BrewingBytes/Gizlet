      if (setting === 'fit' && isBackgroundFit(target.value)) step.fit = target.value;
      if (setting === 'canvasWidth') step.canvasWidth = Number(target.value);
      if (setting === 'canvasHeight') step.canvasHeight = Number(target.value);
      if (setting === 'width') step.width = Number(target.value);
      if (setting === 'height') step.height = Number(target.value);
      if (setting === 'quality') {
        step.quality = Number(target.value);
