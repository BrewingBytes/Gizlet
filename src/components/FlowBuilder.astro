      if (!(item instanceof HTMLLIElement)) throw new Error('The result template is missing.');

      const thumbnail = item.querySelector<HTMLImageElement>('[data-result-thumbnail]');
      const name = item.querySelector<HTMLElement>('[data-result-name]');
      const meta = item.querySelector<HTMLElement>('[data-result-meta]');
