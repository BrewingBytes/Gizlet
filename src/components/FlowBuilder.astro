        // answer, and a hundred thousand lines of it is a download rather
        // than something to look at.
        resultTextContent.textContent = shown.length > maximumResultTextCharacters
          ? `${shown.slice(0, maximumResultTextCharacters)}\n…`
          : shown;
        resultText.hidden = false;
        download.textContent = isCsv ? 'Download CSV' : 'Download JSON';
        download.href = resultUrl;
        download.download = text.file.name;
        result.hidden = false;
        showStatus(`Done. Your ${isCsv ? 'CSV' : 'JSON'} is ready to download.`);
      } else if (outcome.kind === 'pdf') {
        const { pdf } = outcome;

        resultUrl = URL.createObjectURL(pdf.blob);
        resultTitle.textContent = 'Your PDF is ready.';
        resultDetails.textContent = `${describePdfPageCount(pdf.pages)} · ${getPdfPageSizeLabel(pdf.pageSize)} · ${formatFileSize(pdf.blob.size)}`;
        resultFigure.hidden = true;
        download.textContent = 'Download PDF';
        download.href = resultUrl;
        download.download = pdf.name;
        result.hidden = false;
        // The panel is complete before the preview is drawn, so the download
        // is there to be used whether or not the drawing succeeds.
