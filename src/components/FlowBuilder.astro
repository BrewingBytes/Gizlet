     * merge therefore has to resolve the extra ones rather than losing them
     * quietly. An image chain keeps them all — every image step runs over each
     * picture in turn — so this only trims one down to the batch ceiling.
     */
    const applySourceLimit = () => {
      const limit = sourceLimit();

      if (sources.length <= limit) return;

      const dropped = sources.slice(limit);
      const noun = dropped[0].kind === 'pdf' ? 'PDF' : 'image';
      for (const source of dropped) releaseSource(source);
      sources = sources.slice(0, limit);
      showStatus(limit === 1
        ? `This flow makes one file, so it kept ${sources[0].file.name} and removed ${dropped.length} other ${noun}${dropped.length === 1 ? '' : 's'}.`
        : `This flow takes ${describeBatchCount(limit)} at a time, so it removed ${dropped.length} of them.`);
    };
    const addSources = async (selected: readonly File[]) => {
      sourceInput.value = '';
      if (selected.length === 0) return;

      clearError();
      resetResult();

      const multiple = takesSeveral();
      const incoming = multiple ? selected : selected.slice(0, 1);
      const isPdfFlow = categoryId === 'pdf';
      const textPayload = flowInput().kind === 'csv-file'
        ? 'csv-file'
        : flowInput().kind === 'json-text'
          ? 'json-text'
          : undefined;

      // A text document is read here, as it is chosen, rather than at the
      // moment a chain runs on it. A file that is not really a table, or not
      // really JSON, is then refused while the visitor is still choosing it —
      // and a chain is never built on a document nothing could read.
      if (textPayload) {
        const [file] = incoming;

        if (file.size > maximumFlowTextBytes) {
          showError(`${file.name} is larger than the ${Math.round(maximumFlowTextBytes / (1024 * 1024))} MB a flow reads. The whole document is held in this tab while the chain runs, so it has to fit in it.`);
          return;
        }

        showStatus('Reading the document locally…');
        await nextFrame();

        let text: string;

        try {
          text = await file.text();
        } catch {
          clearStatus();
          showError(`${file.name} could not be read to the end. That usually means it changed while the page was reading it — choose it again.`);
          return;
        }

