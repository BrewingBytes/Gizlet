            // document, so a broken or locked file is refused as it is chosen
            // and the flows page still carries no renderer until a run needs one.
            const { openLocalPdfForMerge } = await import('../scripts/pdf-generation');
            const opened = await openLocalPdfForMerge(file);

            added.push({ kind: 'pdf', id: nextSourceId++, file, pages: opened.pageCount });
