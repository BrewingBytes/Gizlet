      } else if (outcome.kind === 'pdf-set') {
        const { pdfs } = outcome;
        const pages = pdfs.reduce((total, pdf) => total + pdf.pages, 0);
        const total = pdfs.reduce((bytes, pdf) => bytes + pdf.blob.size, 0);

        resultUrl = URL.createObjectURL(outcome.archive);
        resultTitle.textContent = 'Your PDFs are ready.';
        resultDetails.textContent = `${describeSplitPdfCount(pdfs.length)} · ${describePdfPageCount(pages)} · ${formatFileSize(total)}`;
        resultFigure.hidden = true;
        resultList.replaceChildren(...pdfs.map(renderPdfResultItem));
        resultList.hidden = false;
        download.textContent = `Download all ${pdfs.length} PDFs`;
        download.href = resultUrl;
        download.download = outcome.archiveName;
        result.hidden = false;
        showStatus('Done. Your PDFs are ready to download.');
      } else if (outcome.kind === 'image-set') {
        const { payloads, failed, fromDocument } = outcome;
        const total = payloads.reduce((bytes, payload) => bytes + payload.file.size, 0);
        const outcomes = [
          ...payloads.map((payload) => ({ status: 'done', name: payload.file.name, output: payload }) as const),
          ...failed.map((failure) => ({ status: 'failed', name: failure.name, reason: failure.reason }) as const),
        ];

        resultUrl = URL.createObjectURL(outcome.archive);
        resultTitle.textContent = 'Your images are ready.';
        resultDetails.textContent = fromDocument && failed.length === 0
          ? `${describePdfImageCount(payloads.length)} · ${getFormatLabel(outputFormat)} · ${formatFileSize(total)}`
          : `${summariseBatch(outcomes, total)} · ${getFormatLabel(outputFormat)}`;
