        clearStatus();
        renderSteps();
        return;
      }

      if (isPdfFlow) {
        if (multiple) {
          const problem = validateMergeSelection([...sources.map((source) => source.file), ...incoming]);
          if (problem) { showError(problem); return; }
        } else if (!isSupportedPdfFile(incoming[0])) {
          showError('Choose a PDF to start this flow.');
          return;
        }
      } else if (combines()) {
        // A combining image chain is held to what the combining Gizlet takes,
        // which is a different ceiling from a batch running the same chain
        // over each picture in turn.
        const problem = validatePdfSelection([...sources.map((source) => source.file), ...incoming]);
        if (problem) { showError(problem); return; }
      } else {
        const problem = validateBatchSelection(incoming, sources.length);
        if (problem) {
