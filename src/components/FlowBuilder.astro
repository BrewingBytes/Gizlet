---
import { getAvailableFlowCategories } from '../data/tool-flows';

// The chooser is derived, so a category with nothing published to start it is
// never offered and a new starting payload needs no edit here.
const categories = getAvailableFlowCategories();
const [firstCategory] = categories;
---

<section class="flow-builder" aria-labelledby="flow-builder-title" data-flow-builder>
  <div class="flow-builder__intro">
    <div>
      <p class="metadata">Gizlet flows</p>
      <h1 id="flow-builder-title">Make a little assembly line.</h1>
      <p>Put a few Gizlets in order. Each block hands its local result to the next one — no uploads, no saved files in the middle.</p>
    </div>
    <p class="flow-builder__local-note"><span aria-hidden="true">●</span> Your files stay in this browser.</p>
  </div>

  <div class="flow-builder__workspace">
    <div class="flow-builder__category">
      <label for="flow-category">
        <span class="metadata">Flow category</span>
        <select id="flow-category" data-flow-category>
          {categories.map((category) => <option value={category.id}>{category.label}</option>)}
        </select>
      </label>
      <p data-category-summary>{firstCategory.summary}</p>
    </div>

    <section class="flow-builder__source" aria-labelledby="flow-source-title" data-source>
      <div class="flow-builder__source-icon" aria-hidden="true">↥</div>
      <div>
        <p class="metadata">Starting input</p>
        <h2 id="flow-source-title" data-source-title>{firstCategory.sourceTitle.one}</h2>
        <p data-source-details>{firstCategory.sourceDetails}</p>
      </div>
      <input data-source-input type="file" accept={firstCategory.accept} aria-label={firstCategory.chooseAriaLabel} hidden />
      <button type="button" class="button-secondary" data-source-select>{firstCategory.chooseLabel.many}</button>
      <button type="button" class="flow-builder__text-button" data-source-clear hidden>Remove</button>
    </section>

    <ol class="flow-builder__source-list" aria-label="Starting files" data-source-list hidden></ol>

    <!-- One starting file, cloned per selected file. -->
    <template data-source-template>
      <li class="flow-source">
        <span class="flow-source__number" data-source-number></span>
        <img class="flow-source__thumbnail" alt="" data-source-thumbnail />
        <span class="flow-source__details">
          <strong data-source-name></strong>
          <span data-source-meta></span>
        </span>
        <span class="flow-source__actions">
          <button type="button" class="flow-source__icon-button" data-source-action="up">↑</button>
          <button type="button" class="flow-source__icon-button" data-source-action="down">↓</button>
          <button type="button" class="flow-source__remove" data-source-action="remove">Remove</button>
        </span>
      </li>
    </template>

    <p class="flow-builder__error" data-error role="alert" hidden></p>
    <p class="flow-builder__status" data-status role="status" aria-live="polite" hidden></p>

    <ol class="flow-builder__steps" aria-label="Planned flow" data-step-list></ol>

    <section class="flow-builder__add-step" aria-labelledby="add-step-title">
      <div class="flow-builder__connector" aria-hidden="true"><span>↓</span></div>
      <div>
        <p class="metadata" id="add-step-title">Next step</p>
        <label for="flow-next-tool">Choose a compatible Gizlet</label>
        <div class="flow-builder__add-controls">
          <select id="flow-next-tool" data-add-select aria-label="Next compatible Gizlet"></select>
          <button type="button" data-add-step>Add step</button>
        </div>
      </div>
    </section>

    <section class="flow-builder__result" aria-labelledby="flow-result-title" data-result hidden>
      <div>
        <p class="metadata">Final result</p>
        <h2 id="flow-result-title" data-result-title>Your image is ready.</h2>
        <p data-result-details></p>
      </div>
      <figure data-result-figure>
        <img data-result-image alt="Final flow result" />
      </figure>
      <div class="flow-builder__preview" data-preview hidden>
        <p class="metadata">Preview</p>
        <div class="flow-builder__preview-page" data-page-area>
          <canvas data-page-canvas aria-label="Current PDF page"></canvas>
          <p class="flow-builder__preview-page-error" data-page-error role="alert" hidden></p>
        </div>
        <div class="flow-builder__pager">
          <button type="button" class="flow-source__icon-button" data-previous aria-label="Previous page">←</button>
          <label class="flow-builder__page-field" for="flow-preview-page">
            <span>Page</span>
            <input id="flow-preview-page" type="text" inputmode="numeric" autocomplete="off" data-page-input aria-label="Go to page" />
            <span data-page-total></span>
          </label>
          <button type="button" class="flow-source__icon-button" data-next aria-label="Next page">→</button>
        </div>
      </div>
      <p class="flow-builder__preview-error" data-preview-error role="status" hidden></p>
      <ol class="flow-builder__result-list" aria-label="Final results" data-result-list hidden></ol>

      <!-- One file of a set, cloned per result, so no filename is ever markup. -->
      <template data-result-template>
        <li class="flow-result">
          <img class="flow-result__thumbnail" alt="" data-result-thumbnail />
          <span class="flow-result__details">
            <strong data-result-name></strong>
            <span data-result-meta></span>
          </span>
          <a class="flow-result__download" data-result-download>Download</a>
        </li>
      </template>
      <div class="flow-builder__result-actions">
        <a data-download>Download image</a>
        <button type="button" class="button-secondary" data-result-clear>Clear result</button>
      </div>
    </section>

    <div class="flow-builder__run">
      <div class="flow-builder__run-copy">
        <p>One download at the end, an archive when a flow makes a set. Intermediate files stay in this browser tab.</p>
        <p class="flow-builder__share">
          <button type="button" class="flow-builder__text-button" data-copy-recipe hidden>Copy recipe link</button>
          <span data-recipe-status role="status" aria-live="polite"></span>
        </p>
      </div>
      <label class="flow-builder__final-format" for="flow-final-format" data-final-format-label hidden>
        <span data-final-format-text>Final output format</span>
        <!-- Options are rebuilt from the chain: what a flow ends by producing
             decides which formats it can honour. -->
        <select id="flow-final-format" data-final-format aria-label="Final output format"></select>
      </label>
      <button type="button" data-run-flow disabled>Run flow</button>
    </div>
  </div>
</section>

<style is:global>
  .flow-builder { max-width: 56rem; }
  .flow-builder__intro { display: flex; align-items: end; justify-content: space-between; gap: var(--space-5); margin-bottom: var(--space-6); }
  .flow-builder__intro > div { max-width: 44rem; }
  .flow-builder__intro h1 { margin-bottom: var(--space-2); font-size: var(--font-size-2xl); }
  .flow-builder__intro p:not(.metadata) { margin: 0; color: var(--text-muted); font-size: var(--font-size-lg); }
  .flow-builder__local-note { flex: 0 0 auto; margin: 0; color: var(--text-muted); font-family: var(--font-mono); font-size: var(--font-size-xs); }
  .flow-builder__local-note span { color: var(--success); }
  .flow-builder__workspace { padding: var(--space-4); border: var(--border-strong-width) solid var(--text); background: var(--surface); }
  .flow-builder__category { display: flex; align-items: end; justify-content: space-between; gap: var(--space-4); margin-bottom: var(--space-4); padding-bottom: var(--space-3); border-bottom: var(--border-width) solid var(--border); }
  .flow-builder__category label { display: grid; gap: var(--space-1); min-width: 12rem; color: var(--text-muted); }
  .flow-builder__category .metadata { margin: 0; }
  .flow-builder__category select { font-family: var(--font-body); color: var(--text); }
  .flow-builder__category p { max-width: 28rem; margin: 0; color: var(--text-muted); font-size: var(--font-size-sm); }
  .flow-builder__source, .flow-builder__result { display: flex; align-items: center; gap: var(--space-3); padding: var(--space-3); border: var(--border-width) solid var(--border); }
  .flow-builder__source-icon { display: grid; width: 2.75rem; height: 2.75rem; flex: 0 0 auto; place-items: center; border: var(--border-strong-width) solid var(--text); background: var(--color-amber); color: var(--color-ink); font-size: var(--font-size-xl); font-weight: 700; }
  .flow-builder__source p, .flow-builder__result p { margin: 0; color: var(--text-muted); }
  .flow-builder__source .metadata, .flow-builder__result .metadata { margin-bottom: var(--space-1); }
  .flow-builder__source h2, .flow-builder__result h2 { margin: 0 0 var(--space-1); font-size: var(--font-size-xl); }
  .flow-builder__source button:first-of-type { margin-left: auto; white-space: nowrap; }
  .flow-builder__text-button { min-height: auto; padding: var(--space-1); border: 0; background: transparent; color: var(--link); font-size: var(--font-size-sm); text-decoration: underline; }
  .flow-builder__error, .flow-builder__status { margin: var(--space-3) 0 0; padding: var(--space-3); border-left: var(--border-strong-width) solid var(--color-red); color: var(--color-red); }
  .flow-builder__status { border-left-color: var(--success); color: var(--text-muted); }
  .flow-builder__steps { margin: 0; padding: 0; list-style: none; }
  .flow-builder__connector { display: grid; height: 2.5rem; place-items: center; color: var(--text-muted); font-family: var(--font-mono); }
  .flow-builder__connector span { display: grid; width: 1.5rem; height: 1.5rem; place-items: center; border: var(--border-width) solid var(--border); border-radius: 50%; background: var(--surface); }
  .flow-block { display: grid; grid-template-columns: auto auto minmax(0, 1fr) auto; gap: var(--space-3); align-items: start; padding: var(--space-3); border: var(--border-strong-width) solid var(--text); }
  .flow-block__grip, .flow-block__number { padding-top: var(--space-1); color: var(--text-muted); font-family: var(--font-mono); font-size: var(--font-size-xs); }
  .flow-block__grip { letter-spacing: -0.1em; }
  .flow-block__heading { display: flex; align-items: start; justify-content: space-between; gap: var(--space-3); }
  .flow-block h2 { margin: 0 0 0.125rem; font-size: var(--font-size-lg); }
  .flow-block__heading p { margin: 0; color: var(--text-muted); font-family: var(--font-mono); font-size: var(--font-size-xs); }
  .flow-block__settings { display: grid; grid-template-columns: minmax(7rem, 1fr) minmax(9rem, 14rem); gap: var(--space-3); align-items: center; margin-top: var(--space-3); padding-top: var(--space-3); border-top: var(--border-width) solid var(--border); color: var(--text-muted); font-family: var(--font-mono); font-size: var(--font-size-xs); text-transform: uppercase; }
