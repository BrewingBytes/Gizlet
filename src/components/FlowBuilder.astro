      if (outcome.kind === 'text') {
        const { text, shown } = outcome;
        const isCsv = text.kind === 'csv-file';

        resultUrl = URL.createObjectURL(text.file);
        resultTitle.textContent = isCsv ? 'Your CSV is ready.' : 'Your JSON is ready.';
