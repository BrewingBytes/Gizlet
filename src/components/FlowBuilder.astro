  .flow-block__quality { display: flex; align-items: center; gap: var(--space-2); text-transform: none; }
  .flow-block__quality input { flex: 1; accent-color: var(--color-amber); }
  .flow-block__quality output { min-width: 2.5rem; color: var(--text); font-family: var(--font-body); }
  .flow-block__actions { display: flex; flex-wrap: wrap; justify-content: end; gap: 0.25rem; }
  .flow-block__icon-button, .flow-block__remove { min-height: 2rem; padding: 0.25rem var(--space-1); border: 0; background: transparent; color: var(--text-muted); font-size: var(--font-size-sm); }
  .flow-block__remove { width: 100%; color: var(--link); text-decoration: underline; }
  .flow-builder__add-step { margin-top: var(--space-1); }
  .flow-builder__add-step > div:last-child { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: var(--space-3); align-items: end; padding: var(--space-3); border: 2px dashed var(--border); }
  .flow-builder__add-step .metadata { grid-row: 1 / span 2; margin: 0; color: var(--text-muted); }
  .flow-builder__add-step label { font-weight: 700; }
  .flow-builder__add-controls { display: flex; gap: var(--space-2); }
  .flow-builder__add-controls select { min-width: 0; }
  .flow-builder__result { display: block; margin-top: var(--space-5); border-color: var(--text); background: color-mix(in srgb, var(--color-amber) 8%, var(--surface)); }
  .flow-builder__result[hidden] { display: none; }
  .flow-builder__result > div:first-child { max-width: 35rem; }
  .flow-builder__result figure { margin: var(--space-3) 0; }
  .flow-builder__result img { display: block; max-width: 100%; max-height: 24rem; margin: 0 auto; border: var(--border-width) solid var(--border); }
  .flow-builder__result-actions { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .flow-builder__result-actions a { display: inline-block; min-height: 2.75rem; padding: calc(var(--space-2) - 2px) var(--space-3); border: var(--border-strong-width) solid var(--button-background); background: var(--button-background); color: var(--button-text); font-weight: 700; line-height: 1.25; text-decoration: none; }
  .flow-builder__run { display: grid; grid-template-columns: minmax(0, 1fr) minmax(10rem, 13rem) auto; align-items: end; gap: var(--space-3); margin-top: var(--space-5); padding-top: var(--space-4); border-top: var(--border-width) solid var(--border); }
  .flow-builder__run p { max-width: 32rem; margin: 0; color: var(--text-muted); font-size: var(--font-size-sm); }
  .flow-builder__run-copy { display: grid; gap: var(--space-1); }
  .flow-builder__share { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--space-2); }
  .flow-builder__share span { color: var(--text-muted); font-family: var(--font-mono); font-size: var(--font-size-xs); }
  .flow-builder__final-format { display: grid; gap: var(--space-1); color: var(--text-muted); font-family: var(--font-mono); font-size: var(--font-size-xs); text-transform: uppercase; }
  .flow-builder__final-format select { min-height: 2.5rem; font-family: var(--font-body); font-size: var(--font-size-sm); text-transform: none; }
  .flow-block__format-note { margin: var(--space-2) 0 0; color: var(--text-muted); font-size: var(--font-size-sm); }
  .flow-block__settings--pdf { grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr)); align-items: end; }
  .flow-block__settings--pdf label { display: grid; gap: var(--space-1); }
  .flow-block__settings--pdf select { min-height: 2.5rem; font-family: var(--font-body); font-size: var(--font-size-sm); text-transform: none; }
  .flow-builder__source-list { margin: 0 0 var(--space-4); padding: 0; list-style: none; }
  .flow-builder__source-list[hidden] { display: none; }
  .flow-source { display: grid; grid-template-columns: 2.5rem 3.5rem minmax(0, 1fr) auto; align-items: center; gap: var(--space-3); padding: var(--space-2) 0; border-bottom: var(--border-width) solid var(--border); }
  .flow-source__number { color: var(--text-muted); font-family: var(--font-mono); font-size: var(--font-size-sm); }
  .flow-source__thumbnail { display: block; width: 3.5rem; height: 3.5rem; border: var(--border-width) solid var(--border); object-fit: contain; background: var(--background); }
  /* A document has no thumbnail, so its row gives that column back to the name. */
  .flow-source--document { grid-template-columns: 2.5rem minmax(0, 1fr) auto; }
  .flow-source__details { display: grid; gap: var(--space-1); min-width: 0; }
  .flow-source__details strong { overflow-wrap: anywhere; }
  .flow-source__details span { color: var(--text-muted); font-family: var(--font-mono); font-size: var(--font-size-xs); }
  .flow-source__actions { display: flex; flex-wrap: wrap; gap: var(--space-1); }
  .flow-source__icon-button { min-width: 2.75rem; min-height: 2.75rem; padding: 0; border: var(--border-width) solid var(--border); background: transparent; color: var(--text); font-weight: 700; }
  .flow-source__icon-button:disabled { color: var(--text-muted); opacity: 0.5; }
  .flow-source__remove { min-height: 2.75rem; padding: 0 var(--space-2); border: var(--border-width) solid var(--border); background: transparent; color: var(--text); }
  .flow-builder__preview { display: grid; gap: var(--space-2); margin: var(--space-3) 0; }
  .flow-builder__preview .metadata { margin: 0; }
  .flow-builder__preview-page { display: grid; justify-items: center; gap: var(--space-2); min-width: 0; padding: var(--space-3); border: var(--border-width) solid var(--border); background: var(--background); overflow: auto; }
  .flow-builder__preview-page canvas { display: block; max-width: 100%; max-height: 24rem; height: auto; background: #fff; box-shadow: 0 1px 4px rgb(0 0 0 / 18%); }
  .flow-builder__preview-page-error { margin: 0; color: var(--color-red); font-size: var(--font-size-sm); }
  .flow-builder__preview-error { margin: 0 0 var(--space-3); padding: var(--space-3); border-left: var(--border-strong-width) solid var(--color-warning); color: var(--color-warning); }
  .flow-builder__pager { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: var(--space-2); }
  .flow-builder__page-field { display: flex; align-items: center; gap: var(--space-2); color: var(--text-muted); font-family: var(--font-mono); font-size: var(--font-size-xs); text-transform: uppercase; }
  /* Specific enough to beat the global control width, which these styles share rather than scope. */
  .flow-builder .flow-builder__page-field input[type='text'] { width: 4rem; min-height: 2.75rem; text-align: center; font-family: var(--font-mono); }
  .flow-builder__preview[hidden], .flow-builder__preview-error[hidden], .flow-builder__preview-page-error[hidden], .flow-builder__result figure[hidden], .flow-builder__final-format[hidden], .flow-builder__result-list[hidden] { display: none; }
  .flow-builder__result-list { margin: var(--space-3) 0; padding: 0; list-style: none; max-height: 24rem; overflow-y: auto; }
  .flow-result { display: grid; grid-template-columns: 3.5rem minmax(0, 1fr) auto; align-items: center; gap: var(--space-3); padding: var(--space-2) 0; border-top: var(--border-width) solid var(--border); }
  .flow-result:last-child { border-bottom: var(--border-width) solid var(--border); }
  .flow-result__thumbnail { display: block; width: 3.5rem; height: 3.5rem; border: var(--border-width) solid var(--border); object-fit: contain; background: #fff; }
  .flow-result__details { display: grid; gap: var(--space-1); min-width: 0; }
  .flow-result__details strong { overflow-wrap: anywhere; }
  .flow-result__details span { color: var(--text-muted); font-family: var(--font-mono); font-size: var(--font-size-xs); }
  .flow-result__download { min-height: 2.75rem; padding: calc(var(--space-2) - 2px) var(--space-3); border: var(--border-width) solid var(--border); color: var(--text); line-height: 1.25; text-decoration: none; white-space: nowrap; }
  @media (max-width: 36rem) {
    .flow-source { grid-template-columns: 2rem 3rem minmax(0, 1fr); }
    .flow-source--document { grid-template-columns: 2rem minmax(0, 1fr); }
    .flow-source__actions { grid-column: 2 / -1; }
  }
  @media (max-width: 42rem) { .flow-builder__intro { display: block; } .flow-builder__local-note { margin-top: var(--space-3); } .flow-builder__workspace { padding: var(--space-3); } .flow-builder__category { display: grid; align-items: start; } .flow-builder__source { align-items: start; flex-wrap: wrap; } .flow-builder__source button:first-of-type { margin-left: 0; } .flow-block { grid-template-columns: 1rem minmax(0, 1fr); } .flow-block__grip { grid-row: 1 / span 3; } .flow-block__number, .flow-block__content, .flow-block__actions { grid-column: 2; } .flow-block__actions { justify-content: start; } .flow-block__remove { width: auto; } .flow-block__settings { grid-template-columns: 1fr; gap: var(--space-1); } .flow-builder__add-step > div:last-child { grid-template-columns: 1fr; } .flow-builder__add-step .metadata { grid-row: auto; } .flow-builder__add-controls { align-items: stretch; flex-direction: column; } .flow-builder__run { grid-template-columns: 1fr; align-items: stretch; } }
</style>

<script>
  import {
    canFlowTo,
    canReorderFlowStep,
    combinesFlowInputs,
    defaultFlowCategoryId,
    flowOutputImageFormats,
    getFlowCategory,
    getFlowFormatControl,
    getFlowTool,
    getNextFlowSteps,
    getUsableFlowFormat,
    isAvailableFlowToolSlug,
    isFlowCategoryId,
    type AvailableFlowToolSlug,
    type FlowCategoryId,
  } from '../data/tool-flows';
  import {
    formatFileSize,
    getFormatLabel,
    getInputImageFormat,
    getOutputFilename,
    getPreferredOutputFormat,
    isSupportedImageFile,
    type ImageOutputFormat,
  } from '../data/image-compression';
  import { getConversionOutputFilename } from '../data/image-conversion';
  import {
    defaultFlowCropAspectRatio,
    flowCropAspectRatioNames,
    getCenteredCrop,
    getCropAspectRatio,
    getCropAspectRatioOptions,
    getCropOutputFilename,
    isFlowCropAspectRatioName,
    type FlowCropAspectRatioName,
  } from '../data/image-crop';
  import { getPdfPreviewErrorMessage, isSupportedPdfFile } from '../data/pdf-viewer';
  import { decodeRecipe, encodeRecipe, type Recipe } from '../data/recipes';
  import { getResizeOutputFilename, validateResizeDimensions } from '../data/image-resize';
  import {
    defaultPdfOrientation,
    defaultPdfPageSize,
    describePdfPageCount,
    getPdfOrientationOptions,
    getPdfOutputFilename,
    getPdfPageSizeLabel,
    getPdfPageSizeOptions,
    isLargePdfWorkload,
    isPdfOrientation,
    isPdfPageSizeName,
    reorderPdfImages,
    usesFixedPageSize,
    validatePdfImage,
    validatePdfSelection,
    type PdfOrientation,
    type PdfPageSizeName,
  } from '../data/jpg-to-pdf';
  import {
    defaultPdfImageResolution,
    describePdfImageCount,
    getPdfImageArchiveName,
    getPdfImageResolutionOptions,
    getPdfToImageErrorMessage,
    isPdfImageResolution,
    validatePdfToImagePageCount,
    type PdfImageResolution,
  } from '../data/pdf-to-jpg';
  import {
    describeMergeDocumentCount,
    getMergedPdfFilename,
    getMergeReadinessMessage,
    isLargeMergeWorkload,
    validateMergeSelection,
    validateMergedPageCount,
  } from '../data/merge-pdf';
  import {
    describeSplitPdfCount,
    getSinglePageRanges,
    getSplitPdfArchiveName,
    validateSplitPdfPageCount,
  } from '../data/split-pdf';
  import { toolRegistry } from '../data/tools';
  import { createZipArchive, zipMimeType } from '../data/zip-archive';
  import { cropBrowserImage, encodeBrowserImage, loadBrowserImage } from '../scripts/image-processing';
  import { createImagePdf, openLocalPdfForSplit, splitLocalPdf } from '../scripts/pdf-generation';
  import { createPdfPageView } from '../scripts/pdf-page-view';

  // Chainable, published, and derived: adding a Gizlet with an image or PDF
  // contract joins the builder without a list here being edited.
  type FlowToolSlug = AvailableFlowToolSlug;

  /**
   * A PDF a flow is holding between blocks. A flow carries a set of these
   * rather than one, because a splitting block turns the one document into
   * several and everything after it then runs over each.
   */
  interface FlowPdf {
    readonly blob: Blob;
    readonly pages: number;
    readonly pageSize: PdfPageSizeName;
    readonly name: string;
  }

  interface FlowStep {
    readonly id: number;
    readonly toolSlug: FlowToolSlug;
    width?: number;
    height?: number;
    quality?: number;
    ratio?: FlowCropAspectRatioName;
    pageSize?: PdfPageSizeName;
    orientation?: PdfOrientation;
    resolution?: PdfImageResolution;
  }

  /**
   * A chosen starting file, read up front so it can be described and refused
   * before a chain is built on it.
   *
   * The two kinds are measured differently because they are different things: an
   * image has pixels and a preview, a document has pages and neither.
   */
  type FlowSource =
    | {
        readonly kind: 'image';
        readonly id: number;
        readonly file: File;
        readonly width: number;
        readonly height: number;
        readonly previewUrl: string;
      }
    | {
        readonly kind: 'pdf';
        readonly id: number;
        readonly file: File;
        readonly pages: number;
      };

  /** What travels between steps. A combining step turns many into one. */
  interface FlowPayload {
    readonly file: File;
    readonly width: number;
    readonly height: number;
  }

  const root = document.querySelector<HTMLElement>('[data-flow-builder]');

  if (root) {
    const sourceInput = root.querySelector<HTMLInputElement>('[data-source-input]');
    const sourceSelect = root.querySelector<HTMLButtonElement>('[data-source-select]');
    const sourceClear = root.querySelector<HTMLButtonElement>('[data-source-clear]');
    const sourceTitle = root.querySelector<HTMLElement>('[data-source-title]');
    const sourceDetails = root.querySelector<HTMLElement>('[data-source-details]');
    const sourceList = root.querySelector<HTMLOListElement>('[data-source-list]');
    const sourceTemplate = root.querySelector<HTMLTemplateElement>('[data-source-template]');
    const error = root.querySelector<HTMLElement>('[data-error]');
    const status = root.querySelector<HTMLElement>('[data-status]');
    const stepList = root.querySelector<HTMLOListElement>('[data-step-list]');
    const addSelect = root.querySelector<HTMLSelectElement>('[data-add-select]');
    const addStepButton = root.querySelector<HTMLButtonElement>('[data-add-step]');
    const categorySelect = root.querySelector<HTMLSelectElement>('[data-flow-category]');
    const categorySummary = root.querySelector<HTMLElement>('[data-category-summary]');
    const finalFormat = root.querySelector<HTMLSelectElement>('[data-final-format]');
    const finalFormatLabel = root.querySelector<HTMLElement>('[data-final-format-label]');
    const finalFormatText = root.querySelector<HTMLElement>('[data-final-format-text]');
    const runButton = root.querySelector<HTMLButtonElement>('[data-run-flow]');
    const result = root.querySelector<HTMLElement>('[data-result]');
    const resultTitle = root.querySelector<HTMLElement>('[data-result-title]');
    const resultDetails = root.querySelector<HTMLElement>('[data-result-details]');
    const resultFigure = root.querySelector<HTMLElement>('[data-result-figure]');
    const resultImage = root.querySelector<HTMLImageElement>('[data-result-image]');
    const preview = root.querySelector<HTMLElement>('[data-preview]');
    const previewError = root.querySelector<HTMLElement>('[data-preview-error]');
    const pageArea = root.querySelector<HTMLElement>('[data-page-area]');
    const pageCanvas = root.querySelector<HTMLCanvasElement>('[data-page-canvas]');
    const pageError = root.querySelector<HTMLElement>('[data-page-error]');
    const previousButton = root.querySelector<HTMLButtonElement>('[data-previous]');
    const nextButton = root.querySelector<HTMLButtonElement>('[data-next]');
    const pageInput = root.querySelector<HTMLInputElement>('[data-page-input]');
    const pageTotal = root.querySelector<HTMLElement>('[data-page-total]');
    const resultList = root.querySelector<HTMLOListElement>('[data-result-list]');
    const resultTemplate = root.querySelector<HTMLTemplateElement>('[data-result-template]');
    const download = root.querySelector<HTMLAnchorElement>('[data-download]');
    const resultClear = root.querySelector<HTMLButtonElement>('[data-result-clear]');
    const copyRecipe = root.querySelector<HTMLButtonElement>('[data-copy-recipe]');
    const recipeStatus = root.querySelector<HTMLElement>('[data-recipe-status]');

    if (!categorySelect || !categorySummary || !sourceInput || !sourceSelect || !sourceClear || !sourceTitle || !sourceDetails || !sourceList || !sourceTemplate || !error || !status || !stepList || !addSelect || !addStepButton || !finalFormat || !finalFormatLabel || !finalFormatText || !runButton || !result || !resultTitle || !resultDetails || !resultFigure || !resultImage || !resultList || !resultTemplate || !preview || !previewError || !pageArea || !pageCanvas || !pageError || !previousButton || !nextButton || !pageInput || !pageTotal || !download || !resultClear || !copyRecipe || !recipeStatus) {
      throw new Error('Flow builder could not initialise.');
    }

    let categoryId: FlowCategoryId = defaultFlowCategoryId;
    let sources: readonly FlowSource[] = [];
    let steps: FlowStep[] = [];
    let nextSourceId = 1;
    let nextStepId = 1;
    let resultUrl: string | undefined;
    /** The object URLs a set of results holds, so none outlives the panel. */
    let resultItemUrls: string[] = [];
    let isRunning = false;
    let outputFormat: ImageOutputFormat = 'image/webp';
    // A recipe's chosen format outlives the source file, which would otherwise
    // reset it to the format preferred for that input.
    let outputFormatFromRecipe = false;
    // A preview arrives after the document it belongs to, so a later run must
    // be able to discard an earlier one's rather than show the wrong document.
    let previewToken = 0;

    /**
     * The preview's page turning, shared with the two PDF workspaces. A flow
     * shows what it produced rather than offering a reading workspace, so the
     * page is fitted to its column and there is nothing to zoom.
     */
    const pageView = createPdfPageView({
      pageArea,
      canvas: pageCanvas,
      pageError,
      previousButton,
      nextButton,
      pageInput,
      pageTotal,
    });

    const toolBySlug = (toolSlug: FlowToolSlug) => {
      const tool = toolRegistry.find((candidate) => candidate.slug === toolSlug);
      if (!tool) throw new Error(`Missing Gizlet: ${toolSlug}`);
      return tool;
    };
    const escapeHtml = (value: string | number) => String(value).replace(/[&<>'"]/g, (character) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' })[character] ?? character);
    const nextFrame = () => new Promise<void>((resolve) => requestAnimationFrame(() => resolve()));
    const clearError = () => { error.hidden = true; error.textContent = ''; };
    const showError = (message: string) => { error.textContent = message; error.hidden = false; };
    const clearStatus = () => { status.hidden = true; status.textContent = ''; };
    const showStatus = (message: string) => { status.textContent = message; status.hidden = false; };

    /** The starting payload every graph question is asked against. */
    const category = () => getFlowCategory(categoryId);
    const flowInput = () => category().input;

    const stepSlugs = (): readonly FlowToolSlug[] => steps.map((step) => step.toolSlug);
    /** A chain with a combining step makes one file out of several sources. */
    const combines = () => combinesFlowInputs(stepSlugs());
    /**
     * Whether an image format applies, what it is called, and which formats it
     * offers — one answer from one place, so a chain that ends in a document
     * cannot be asked for a format it would re-encode away.
     */
    const formatControl = () => getFlowFormatControl(stepSlugs());
    /** How many starting files this chain has room for. */
    const sourceLimit = () => (combines() ? category().combiningLimit : 1);
    /**
     * Why this chain cannot run yet, if it cannot.
     *
     * A merge is the one step with a floor as well as a ceiling: one document
     * is not a merge. Saying so beside the sources is the alternative to a
     * disabled button that explains nothing.
     */
    const startReadiness = () =>
      stepSlugs().includes('merge-pdf') ? getMergeReadinessMessage(sources.length) : undefined;
    /** Only an image source holds an object URL, so only one has to give it back. */
    const releaseSource = (source: FlowSource) => {
      if (source.kind === 'image') URL.revokeObjectURL(source.previewUrl);
    };

    const revokeResult = () => {
      if (resultUrl) URL.revokeObjectURL(resultUrl);
      resultUrl = undefined;
      for (const url of resultItemUrls) URL.revokeObjectURL(url);
      resultItemUrls = [];
    };
    const resetResult = () => {
      revokeResult();
      // Discards a preview still being drawn, so clearing the panel cannot be
      // followed by a page appearing in it.
      previewToken += 1;
      pageView.reset();
      preview.hidden = true;
      previewError.hidden = true;
      previewError.textContent = '';
      result.hidden = true;
      resultImage.removeAttribute('src');
      resultFigure.hidden = false;
      resultList.hidden = true;
      resultList.replaceChildren();
      resultTitle.textContent = 'Your image is ready.';
      download.textContent = 'Download image';
      download.removeAttribute('href');
      download.removeAttribute('download');
      resultDetails.textContent = '';
    };

    const availableStepSlugs = (): readonly FlowToolSlug[] => {
      return getNextFlowSteps(flowInput(), stepSlugs())
        .map((candidate) => candidate.toolSlug)
        .filter(isAvailableFlowToolSlug);
    };
    const defaultStep = (toolSlug: FlowToolSlug): FlowStep => ({
      id: nextStepId++,
      toolSlug,
      ...(toolSlug === 'resize-image' ? { width: 500, height: 500 } : {}),
      ...(toolSlug === 'compress-image' ? { quality: 80 } : {}),
      ...(toolSlug === 'crop-image' ? { ratio: defaultFlowCropAspectRatio } : {}),
      ...(toolSlug === 'jpg-to-pdf' ? { pageSize: defaultPdfPageSize, orientation: defaultPdfOrientation } : {}),
      ...(toolSlug === 'pdf-to-jpg' ? { resolution: defaultPdfImageResolution } : {}),
    });
    const canReorder = (fromIndex: number, toIndex: number): boolean => {
      return canReorderFlowStep(flowInput(), stepSlugs(), fromIndex, toIndex);
    };
    const renderAddOptions = () => {
      const candidates = availableStepSlugs();
      // Reading the source is asynchronous, so a redraw can land between the
      // visitor choosing the next Gizlet and pressing Add step. Rebuilding the
      // options must not throw that choice away.
      const pending = addSelect.value;

      addSelect.innerHTML = `<option value="">Choose the next Gizlet</option>${candidates.map((toolSlug) => `<option value="${toolSlug}">${toolBySlug(toolSlug).name}</option>`).join('')}`;

      if (isAvailableFlowToolSlug(pending) && candidates.includes(pending)) {
        addSelect.value = pending;
      }

      addStepButton.disabled = candidates.length === 0 || isRunning;
    };
    const optionsMarkup = <Value extends string>(
      options: readonly { readonly value: Value; readonly label: string }[],
      selected: Value,
    ): string =>
      options
        .map((option) => `<option value="${option.value}"${option.value === selected ? ' selected' : ''}>${escapeHtml(option.label)}</option>`)
        .join('');
    const settingsMarkup = (step: FlowStep): string => {
      const name = toolBySlug(step.toolSlug).name;
      if (step.toolSlug === 'resize-image') {
        return `<div class="flow-block__settings"><span>Dimensions</span><div class="flow-block__dimensions"><input data-step-setting="width" data-step-id="${step.id}" aria-label="${name} width" type="number" min="1" value="${escapeHtml(step.width ?? 500)}" /><span>×</span><input data-step-setting="height" data-step-id="${step.id}" aria-label="${name} height" type="number" min="1" value="${escapeHtml(step.height ?? 500)}" /><span>px</span></div></div>`;
      }
      if (step.toolSlug === 'compress-image') {
        return `<div class="flow-block__settings"><label for="step-quality-${step.id}">Quality</label><div class="flow-block__quality"><input id="step-quality-${step.id}" data-step-setting="quality" data-step-id="${step.id}" aria-label="${name} quality" type="range" min="40" max="100" value="${escapeHtml(step.quality ?? 80)}" ${outputFormat === 'image/png' ? 'disabled' : ''} /><output data-quality-output="${step.id}">${escapeHtml(step.quality ?? 80)}%</output></div></div>${outputFormat === 'image/png' ? '<p class="flow-block__format-note">PNG does not use a quality setting.</p>' : ''}`;
      }
      if (step.toolSlug === 'crop-image') {
        const ratio = step.ratio ?? defaultFlowCropAspectRatio;
        return `<div class="flow-block__settings"><label for="step-ratio-${step.id}">Crop to</label><select id="step-ratio-${step.id}" data-step-setting="ratio" data-step-id="${step.id}" aria-label="${name} aspect ratio">${optionsMarkup(getCropAspectRatioOptions(flowCropAspectRatioNames), ratio)}</select></div><p class="flow-block__format-note">The largest rectangle of that shape, taken from the middle of the image.</p>`;
      }
      if (step.toolSlug === 'jpg-to-pdf') {
        const pageSize = step.pageSize ?? defaultPdfPageSize;
        const orientation = step.orientation ?? defaultPdfOrientation;
        const fixed = usesFixedPageSize(pageSize);
        return `<div class="flow-block__settings flow-block__settings--pdf"><label for="step-page-size-${step.id}"><span>Page size</span><select id="step-page-size-${step.id}" data-step-setting="pageSize" data-step-id="${step.id}" aria-label="${name} page size">${optionsMarkup(getPdfPageSizeOptions(), pageSize)}</select></label><label for="step-orientation-${step.id}"><span>Orientation</span><select id="step-orientation-${step.id}" data-step-setting="orientation" data-step-id="${step.id}" aria-label="${name} orientation" ${fixed ? '' : 'disabled'}>${optionsMarkup(getPdfOrientationOptions(), orientation)}</select></label></div>${fixed ? '' : '<p class="flow-block__format-note">A fitted page already has the image’s own orientation.</p>'}`;
      }
      if (step.toolSlug === 'pdf-to-jpg') {
        const resolution = step.resolution ?? defaultPdfImageResolution;
        return `<div class="flow-block__settings"><label for="step-resolution-${step.id}">Resolution</label><select id="step-resolution-${step.id}" data-step-setting="resolution" data-step-id="${step.id}" aria-label="${name} resolution">${optionsMarkup(getPdfImageResolutionOptions(), resolution)}</select></div><p class="flow-block__format-note">Every page of the document becomes an image, in the format chosen below.</p>`;
      }
      return '';
    };
    const renderSources = () => {
      const showList = combines() && sources.length > 0;
      const many = combines();
      const { sourceTitle: titles, sourceDetails: details, chooseLabel, addLabel, combiningLimit, describeSourceCount } = category();

      sourceList.hidden = !showList;
      sourceList.replaceChildren(...(showList ? sources.map(renderSource) : []));

      sourceTitle.textContent = many ? titles.many : titles.one;
      sourceInput.multiple = many;
      sourceInput.accept = category().accept;
      sourceInput.setAttribute('aria-label', category().chooseAriaLabel);

      if (sources.length === 0) {
        sourceDetails.textContent = many ? `${details} Up to ${describeSourceCount(combiningLimit)}.` : details;
      } else if (many) {
        sourceDetails.textContent = `${describeSourceCount(sources.length)} · stays on this device`;
      } else {
        sourceDetails.textContent = `${sources[0].file.name} · ${formatFileSize(sources[0].file.size)} · stays on this device`;
      }

      const readiness = startReadiness();

      if (readiness) sourceDetails.textContent = readiness;

      sourceSelect.textContent = sources.length === 0
        ? (many ? chooseLabel.many : chooseLabel.one)
        : (many ? addLabel.many : addLabel.one);
      sourceSelect.disabled = isRunning;
      sourceClear.hidden = sources.length === 0;
      sourceClear.textContent = sources.length > 1 ? 'Remove all' : 'Remove';
      sourceClear.disabled = isRunning;
    };
    /** One starting file, cloned from the template so a filename is never markup. */
    const renderSource = (source: FlowSource, index: number): HTMLLIElement => {
      const item = sourceTemplate.content.firstElementChild?.cloneNode(true);
      if (!(item instanceof HTMLLIElement)) throw new Error('The starting-file template is missing.');

      const number = item.querySelector<HTMLElement>('[data-source-number]');
      const thumbnail = item.querySelector<HTMLImageElement>('[data-source-thumbnail]');
      const name = item.querySelector<HTMLElement>('[data-source-name]');
      const meta = item.querySelector<HTMLElement>('[data-source-meta]');

      if (!number || !thumbnail || !name || !meta) throw new Error('The starting-file template is incomplete.');

      number.textContent = String(index + 1).padStart(2, '0');

      if (source.kind === 'image') {
        thumbnail.src = source.previewUrl;
        thumbnail.alt = `Page ${index + 1}: ${source.file.name}`;
        meta.textContent = `${source.width} × ${source.height} px · ${formatFileSize(source.file.size)}`;
      } else {
        // A document has no single picture to stand for it, and a blank frame
        // beside every row would only say so repeatedly.
        thumbnail.remove();
        item.classList.add('flow-source--document');
        meta.textContent = `${describePdfPageCount(source.pages)} · ${formatFileSize(source.file.size)}`;
      }

      name.textContent = source.file.name;

      for (const button of item.querySelectorAll<HTMLButtonElement>('[data-source-action]')) {
        const action = button.dataset.sourceAction;

        button.dataset.sourceId = String(source.id);
        button.setAttribute(
          'aria-label',
          action === 'remove'
            ? `Remove ${source.file.name}`
            : `Move ${source.file.name} ${action === 'up' ? 'up' : 'down'}`,
        );
        button.disabled =
          isRunning ||
          (action === 'up' && index === 0) ||
          (action === 'down' && index === sources.length - 1);
      }

      return item;
    };
    /** One file of a set, cloned from the template so a filename is never markup. */
    const renderResultItem = (payload: FlowPayload): HTMLLIElement => {
      const item = resultTemplate.content.firstElementChild?.cloneNode(true);
      if (!(item instanceof HTMLLIElement)) throw new Error('The result template is missing.');

      const thumbnail = item.querySelector<HTMLImageElement>('[data-result-thumbnail]');
      const name = item.querySelector<HTMLElement>('[data-result-name]');
      const meta = item.querySelector<HTMLElement>('[data-result-meta]');
      const link = item.querySelector<HTMLAnchorElement>('[data-result-download]');

      if (!thumbnail || !name || !meta || !link) throw new Error('The result template is incomplete.');

      const url = URL.createObjectURL(payload.file);
      resultItemUrls.push(url);

      thumbnail.src = url;
      name.textContent = payload.file.name;
      meta.textContent = `${payload.width} × ${payload.height} px · ${formatFileSize(payload.file.size)}`;
      link.href = url;
      link.download = payload.file.name;
      link.setAttribute('aria-label', `Download ${payload.file.name}`);

      return item;
    };
    /**
     * One PDF of a set, cloned from the same template. Its thumbnail is dropped
     * rather than left empty: a PDF has no picture of itself to show without
     * drawing it, and a set of documents is a list rather than a contact sheet.
     */
    const renderPdfResultItem = (pdf: FlowPdf): HTMLLIElement => {
      const item = resultTemplate.content.firstElementChild?.cloneNode(true);
      if (!(item instanceof HTMLLIElement)) throw new Error('The result template is missing.');

      const thumbnail = item.querySelector<HTMLImageElement>('[data-result-thumbnail]');
      const name = item.querySelector<HTMLElement>('[data-result-name]');
      const meta = item.querySelector<HTMLElement>('[data-result-meta]');
      const link = item.querySelector<HTMLAnchorElement>('[data-result-download]');

      if (!thumbnail || !name || !meta || !link) throw new Error('The result template is incomplete.');

      const url = URL.createObjectURL(pdf.blob);
      resultItemUrls.push(url);

      thumbnail.remove();
      name.textContent = pdf.name;
      meta.textContent = `${describePdfPageCount(pdf.pages)} · ${formatFileSize(pdf.blob.size)}`;
      link.href = url;
      link.download = pdf.name;
      link.setAttribute('aria-label', `Download ${pdf.name}`);

      return item;
    };
    /**
     * Draws the format control the chain actually has.
     *
     * The options are rebuilt rather than merely relabelled, because a chain
     * that ends in a document cannot honour every format an image chain can,
     * and a select still offering one would be a setting the run ignores.
     */
    const renderFormatControl = () => {
      const control = formatControl();
      const usable = getUsableFlowFormat(control, outputFormat);

      if (usable && usable !== outputFormat) {
        outputFormat = usable;
        // A format the chain dropped was chosen for a chain that no longer
        // exists, so it stops counting as the visitor's own choice.
        outputFormatFromRecipe = false;
      }

      finalFormatLabel.hidden = control.kind === 'none';

      if (control.kind !== 'none') {
        finalFormatText.textContent = control.label;
        finalFormat.setAttribute('aria-label', control.label);
      }

      // A hidden control still holds a format: an empty chain is one step away
      // from needing one, and this select is where that choice lives.
      const formats = control.kind === 'none' ? flowOutputImageFormats : control.formats;

      finalFormat.disabled = isRunning;
      finalFormat.replaceChildren(...formats.map((format) => {
        const option = document.createElement('option');
        option.value = format;
        option.textContent = getFormatLabel(format);
        return option;
      }));
      finalFormat.value = outputFormat;
    };
    const renderSteps = () => {
      stepList.innerHTML = steps.map((step, index) => {
        const tool = toolBySlug(step.toolSlug);
        const { sourceTitle: titles } = category();
        const prior = index > 0
          ? `${toolBySlug(steps[index - 1].toolSlug).name} result`
          : (combines() ? titles.many : titles.one);
        const contract = getFlowTool(step.toolSlug);
        const produces = contract.combinesInputs === true
          ? 'one PDF'
          : contract.splitsInput === true
            ? (contract.output.kind === 'pdf-file' ? 'one PDF per page' : 'one image per page')
            : 'image result';
        return `<li><div class="flow-builder__connector" aria-hidden="true"><span>↓</span></div><article class="flow-block"><div class="flow-block__grip" aria-hidden="true">⠿</div><div class="flow-block__number">${String(index + 1).padStart(2, '0')}</div><div class="flow-block__content"><div class="flow-block__heading"><div><h2>${tool.name}</h2><p>${prior} → ${produces}</p></div><span class="status-local">Local</span></div>${settingsMarkup(step)}</div><div class="flow-block__actions" aria-label="${tool.name} controls"><button type="button" class="flow-block__icon-button" data-step-action="up" data-step-id="${step.id}" aria-label="Move ${tool.name} up" ${index === 0 || !canReorder(index, index - 1) || isRunning ? 'disabled' : ''}>↑</button><button type="button" class="flow-block__icon-button" data-step-action="down" data-step-id="${step.id}" aria-label="Move ${tool.name} down" ${index === steps.length - 1 || !canReorder(index, index + 1) || isRunning ? 'disabled' : ''}>↓</button><button type="button" class="flow-block__remove" data-step-action="remove" data-step-id="${step.id}" ${isRunning ? 'disabled' : ''}>Remove</button></div></article></li>`;
      }).join('');
      renderAddOptions();

      renderFormatControl();

      renderSources();
      runButton.disabled = sources.length === 0 || steps.length === 0 || isRunning || startReadiness() !== undefined;
      copyRecipe.hidden = steps.length === 0;
    };
    /**
     * A chain without a combining step makes one file, so it carries one source.
     * Dropping the combining step therefore has to resolve the extra ones, and
     * say which it kept rather than losing them quietly.
     */
    const applySourceLimit = () => {
      const limit = sourceLimit();

      if (sources.length <= limit) return;

      const dropped = sources.slice(limit);
      const noun = dropped[0].kind === 'pdf' ? 'PDF' : 'image';
      for (const source of dropped) releaseSource(source);
      sources = sources.slice(0, limit);
      showStatus(`This flow makes one file, so it kept ${sources[0].file.name} and removed ${dropped.length} other ${noun}${dropped.length === 1 ? '' : 's'}.`);
    };
    const addSources = async (selected: readonly File[]) => {
      sourceInput.value = '';
      if (selected.length === 0) return;

      clearError();
      resetResult();

      const multiple = combines();
      const incoming = multiple ? selected : selected.slice(0, 1);
      const isPdfFlow = categoryId === 'pdf';

      if (isPdfFlow) {
        if (multiple) {
          const problem = validateMergeSelection([...sources.map((source) => source.file), ...incoming]);
          if (problem) { showError(problem); return; }
        } else if (!isSupportedPdfFile(incoming[0])) {
          showError('Choose a PDF to start this flow.');
          return;
        }
      } else if (multiple) {
        const problem = validatePdfSelection([...sources.map((source) => source.file), ...incoming]);
        if (problem) { showError(problem); return; }
      } else if (!isSupportedImageFile(incoming[0])) {
        showError('Choose a JPEG, PNG, WebP, AVIF, or BMP image to start this flow.');
        return;
      }

      const readingNoun = isPdfFlow ? 'document' : 'image';
      showStatus(incoming.length === 1
        ? `Reading the ${readingNoun} locally…`
        : `Reading ${readingNoun}s locally…`);
      await nextFrame();

      const added: FlowSource[] = [];

      try {
        for (const file of incoming) {
          if (isPdfFlow) {
            // pdf-lib, not pdf.js: a page count comes out of opening the
            // document, so a broken or locked file is refused as it is chosen
            // and the flows page still carries no renderer until a run needs one.
            const { openLocalPdfForMerge } = await import('../scripts/pdf-generation');
            const opened = await openLocalPdfForMerge(file);

            added.push({ kind: 'pdf', id: nextSourceId++, file, pages: opened.pageCount });
            continue;
          }

          const image = await loadBrowserImage(file);
          const dimensions = { width: image.naturalWidth, height: image.naturalHeight };
          const problem = multiple
            ? validatePdfImage(file.name, dimensions)
            : (!dimensions.width || !dimensions.height ? 'This image could not be read.' : undefined);

          if (problem) throw new Error(problem);

          added.push({
            kind: 'image',
            id: nextSourceId++,
            file,
            width: dimensions.width,
            height: dimensions.height,
            previewUrl: URL.createObjectURL(file),
          });
        }

        if (isPdfFlow && multiple) {
          // Every document has reported its pages, so the total the merge would
          // write can be checked before the visitor builds a chain on it.
          const total = [...sources, ...added]
            .reduce((pages, source) => pages + (source.kind === 'pdf' ? source.pages : 0), 0);
          const problem = validateMergedPageCount(total);

          if (problem) throw new Error(problem);
        }
      } catch (caughtError) {
        for (const source of added) releaseSource(source);
        clearStatus();
        showError(caughtError instanceof Error
          ? caughtError.message
          : `This ${readingNoun} could not be read.`);
        renderSteps();
        return;
      }

      // A single-source flow replaces rather than appends: it has room for one.
      if (!multiple) {
        for (const source of sources) releaseSource(source);
        sources = [];
      }

      sources = [...sources, ...added];

      const [first] = sources;

      if (!outputFormatFromRecipe && first.kind === 'image') {
        outputFormat = getPreferredOutputFormat(getInputImageFormat(first.file));
      }

      clearStatus();
      renderSteps();
    };
    const clearSources = () => {
      for (const source of sources) releaseSource(source);
      sources = [];
      sourceInput.value = '';
      resetResult();
      clearError();
      clearStatus();
      renderSteps();
    };
    const updateStepSetting = (target: HTMLInputElement | HTMLSelectElement) => {
      const id = Number(target.dataset.stepId);
      const step = steps.find((candidate) => candidate.id === id);
      const setting = target.dataset.stepSetting;
      if (!step || !setting) return;

      // A page size decides whether orientation applies at all, so this one
      // redraws the block instead of only recording the value.
      if (setting === 'pageSize' && isPdfPageSizeName(target.value) && step.pageSize !== target.value) {
        step.pageSize = target.value;
        resetResult();
        renderSteps();
        return;
      }

      if (setting === 'orientation' && isPdfOrientation(target.value)) step.orientation = target.value;
      if (setting === 'resolution' && isPdfImageResolution(target.value)) step.resolution = target.value;
      if (setting === 'ratio' && isFlowCropAspectRatioName(target.value)) step.ratio = target.value;
      if (setting === 'width') step.width = Number(target.value);
      if (setting === 'height') step.height = Number(target.value);
      if (setting === 'quality') {
        step.quality = Number(target.value);
        const output = stepList.querySelector<HTMLOutputElement>(`[data-quality-output="${id}"]`);
        if (output) output.textContent = `${step.quality}%`;
      }
      resetResult();
    };
    /** One image through one image step, keeping the dimensions it came out at. */
    const runImageStep = async (step: FlowStep, payload: FlowPayload): Promise<FlowPayload> => {
      const image = await loadBrowserImage(payload.file);
      const sourceDimensions = { width: image.naturalWidth, height: image.naturalHeight };
      if (!sourceDimensions.width || !sourceDimensions.height) throw new Error('This image has no usable dimensions.');

      let dimensions = sourceDimensions;
      if (step.toolSlug === 'resize-image') {
        dimensions = { width: Math.round(step.width ?? 0), height: Math.round(step.height ?? 0) };
        const validation = validateResizeDimensions(dimensions);
        if (validation) throw new Error(`Resize Image: ${validation}`);
      }

      // A flow has nobody to drag a rectangle, so a crop block takes the
      // largest centred one of its chosen shape: what the workspace opens on
      // when that ratio is picked and nothing else is touched.
      let source: CanvasImageSource = image;
      if (step.toolSlug === 'crop-image') {
        const rectangle = getCenteredCrop(sourceDimensions, getCropAspectRatio(step.ratio ?? defaultFlowCropAspectRatio));
        source = cropBrowserImage(image, rectangle);
        dimensions = { width: rectangle.width, height: rectangle.height };
      }

      const blob = await encodeBrowserImage(source, dimensions, outputFormat, step.toolSlug === 'compress-image' ? (step.quality ?? 80) / 100 : undefined);
      const filename = step.toolSlug === 'convert-image'
        ? getConversionOutputFilename(payload.file.name, outputFormat)
        : step.toolSlug === 'resize-image'
          ? getResizeOutputFilename(payload.file.name, outputFormat)
          : step.toolSlug === 'crop-image'
            ? getCropOutputFilename(payload.file.name, outputFormat)
            : getOutputFilename(payload.file.name, outputFormat);

      return { file: new File([blob], filename, { type: blob.type }), ...dimensions };
    };
    /**
     * Draws the document the flow produced, so the page order and what
     * automatic orientation did to each sheet can be read before anything is
     * downloaded — the same thing the image result panel does with an image.
     *
     * pdf.js is imported here rather than at the top of the module: it and its
     * worker are over a megabyte between them, and a flow that never makes a
     * PDF has no use for either. A static import would put both in this page's
     * initial JavaScript, where every visitor would pay for them.
     */
    const drawPreview = async (pdf: Blob) => {
      const token = ++previewToken;

      showStatus('Drawing the preview locally…');
      await nextFrame();

      try {
        const { openLocalPdf } = await import('../scripts/pdf-rendering');
        const opened = await openLocalPdf(pdf);

        if (token !== previewToken) {
          await opened.close().catch(() => undefined);
          return;
        }

        preview.hidden = false;
        await pageView.show(opened);
      } catch {
        if (token !== previewToken) return;
        // A document can be perfectly good even when drawing it is not, so the
        // preview goes and the finished file stays where the visitor left it.
        preview.hidden = true;
        previewError.textContent = getPdfPreviewErrorMessage();
        previewError.hidden = false;
      }
    };
    const runFlow = async () => {
      if (sources.length === 0 || steps.length === 0 || isRunning) return;
      isRunning = true;
      clearError();
      resetResult();
      renderSteps();
      runButton.textContent = 'Running…';

      // A flow starts in whichever hand the category filled: images travel as
      // payloads and documents as results, which is the same pair of hands every
      // block after the first one uses.
      let payloads: readonly FlowPayload[] = sources
        .filter((source): source is Extract<FlowSource, { kind: 'image' }> => source.kind === 'image')
        .map((source) => ({ file: source.file, width: source.width, height: source.height }));
      let pdfResults: readonly FlowPdf[] = sources
        .filter((source): source is Extract<FlowSource, { kind: 'pdf' }> => source.kind === 'pdf')
        .map((source) => ({
          blob: source.file,
          pages: source.pages,
          // A chosen document lays its own pages out; nothing here re-sizes them,
          // and `fit` is the page size that says exactly that.
          pageSize: 'fit',
          name: source.file.name,
        }));
      // The document a set came out of, which names its archive. It is the
      // earliest such document rather than the latest: a split followed by a
      // conversion has taken the same original apart twice over.
      let setSourceName: string | undefined;

      try {
        for (const [index, step] of steps.entries()) {
          const tool = toolBySlug(step.toolSlug);
          const position = `${index + 1} of ${steps.length}`;

          if (step.toolSlug === 'jpg-to-pdf') {
            const pageSize = step.pageSize ?? defaultPdfPageSize;
            const isLarge = isLargePdfWorkload(payloads);
            const pages = payloads.length;
            const name = getPdfOutputFilename(payloads[0].file.name, pages);
            const blob = await createImagePdf(payloads, {
              pageSize,
              orientation: step.orientation ?? defaultPdfOrientation,
              onPage: async (pageNumber, pageCount) => {
                showStatus(`Running ${position}: ${tool.name}${isLarge ? ', large document' : ''}, page ${pageNumber} of ${pageCount} locally…`);
                await nextFrame();
              },
            });

            pdfResults = [{ blob, pages, pageSize, name }];
            payloads = [];
            continue;
          }

          if (step.toolSlug === 'merge-pdf') {
            if (pdfResults.length === 0) throw new Error(`${tool.name} needs the PDFs this flow started from.`);

            const { mergeLocalPdfs, openLocalPdfForMerge } = await import('../scripts/pdf-generation');

            showStatus(`Running ${position}: ${tool.name}, reading the documents locally…`);
            await nextFrame();

            // Opened again here rather than held since they were chosen: a
            // merge copies page trees out of live documents, and re-reading
            // them is cheaper than keeping parsed ones alive across every edit.
            const merging = [];

            for (const pdf of pdfResults) {
              merging.push(await openLocalPdfForMerge(
                pdf.blob instanceof File ? pdf.blob : new File([pdf.blob], pdf.name, { type: 'application/pdf' }),
              ));
            }

            const isLarge = isLargeMergeWorkload(merging);
            const pages = merging.reduce((total, document) => total + document.pageCount, 0);
            const blob = await mergeLocalPdfs(merging, {
              onDocument: async (documentNumber, documentCount) => {
                showStatus(`Running ${position}: ${tool.name}${isLarge ? ', large document' : ''}, ${describeMergeDocumentCount(documentCount)}, joining ${documentNumber} of ${documentCount} locally…`);
                await nextFrame();
              },
            });

            pdfResults = [{ blob, pages, pageSize: 'fit', name: getMergedPdfFilename(merging[0].file.name) }];
            continue;
          }

          if (step.toolSlug === 'pdf-to-jpg') {
            // Only a PDF block can precede this one, so the graph guarantees a
            // document is waiting; the check is here because a chain that
            // reached this state some other way must say so rather than throw.
            if (pdfResults.length === 0) throw new Error(`${tool.name} needs a PDF from the block before it.`);

            showStatus(`Running ${position}: ${tool.name}, reading the document locally…`);
            await nextFrame();

            // pdf.js is loaded only when a flow actually reaches this block, so
            // the page carries neither the library nor its worker until then.
            const { openLocalPdf } = await import('../scripts/pdf-rendering');
            const { renderPdfPagesToImages } = await import('../scripts/pdf-to-image');
            const converted: FlowPayload[] = [];

            // A splitting block before this one leaves several documents, so
            // every one of them is drawn and their pages join one set.
            for (const pdf of pdfResults) {
              const opened = await openLocalPdf(pdf.blob, {
                getErrorMessage: getPdfToImageErrorMessage,
              });

              try {
                const countProblem = validatePdfToImagePageCount(opened.pageCount);
                if (countProblem) throw new Error(countProblem);

                const images = await renderPdfPagesToImages(opened, {
                  documentName: pdf.name,
                  pageNumbers: Array.from({ length: opened.pageCount }, (_, page) => page + 1),
                  pageCount: opened.pageCount,
                  format: outputFormat,
                  resolution: step.resolution ?? defaultPdfImageResolution,
                  onPage: async (pagePosition, total) => {
                    showStatus(`Running ${position}: ${tool.name}, page ${pagePosition} of ${total} locally…`);
                    await nextFrame();
                  },
                });

                for (const image of images) {
                  converted.push({ file: image.file, width: image.width, height: image.height });
                }
              } finally {
                await opened.close().catch(() => undefined);
              }
            }

            payloads = converted;
            setSourceName ??= pdfResults[0].name;
            pdfResults = [];
            continue;
          }

          if (step.toolSlug === 'split-pdf') {
            if (pdfResults.length === 0) throw new Error(`${tool.name} needs a PDF from the block before it.`);

            const split: FlowPdf[] = [];
            setSourceName ??= pdfResults[0].name;

            for (const pdf of pdfResults) {
              showStatus(`Running ${position}: ${tool.name}, reading the document locally…`);
              await nextFrame();

              const source = await openLocalPdfForSplit(pdf.blob);
              const countProblem = validateSplitPdfPageCount(source.pageCount);
              if (countProblem) throw new Error(countProblem);

              // A flow has no field to name ranges in, so it splits the
              // document into its pages: one page per document is the piece
              // every block after this one can use.
              const parts = await splitLocalPdf(source, getSinglePageRanges(source.pageCount), {
                documentName: pdf.name,
                pageCount: source.pageCount,
                onPart: async (partPosition, total) => {
                  showStatus(`Running ${position}: ${tool.name}, document ${partPosition} of ${total} locally…`);
                  await nextFrame();
                },
              });

              for (const part of parts) {
                split.push({
                  blob: part.file,
                  pages: 1,
                  pageSize: pdf.pageSize,
                  name: part.file.name,
                });
              }
            }

            pdfResults = split;
            continue;
          }

          const processed: FlowPayload[] = [];
          for (const [payloadIndex, payload] of payloads.entries()) {
            showStatus(payloads.length === 1
              ? `Running ${position}: ${tool.name} locally…`
              : `Running ${position}: ${tool.name} on image ${payloadIndex + 1} of ${payloads.length} locally…`);
            await nextFrame();
            processed.push(await runImageStep(step, payload));
          }
          payloads = processed;
        }

        if (pdfResults.length === 1) {
          const [pdf] = pdfResults;

          resultUrl = URL.createObjectURL(pdf.blob);
          resultTitle.textContent = 'Your PDF is ready.';
          resultDetails.textContent = `${describePdfPageCount(pdf.pages)} · ${getPdfPageSizeLabel(pdf.pageSize)} · ${formatFileSize(pdf.blob.size)}`;
          resultFigure.hidden = true;
          download.textContent = 'Download PDF';
          download.href = resultUrl;
          download.download = pdf.name;
          result.hidden = false;
          // The panel is complete before the preview is drawn, so the download
          // is there to be used whether or not the drawing succeeds.
          await drawPreview(pdf.blob);
          showStatus('Done. Your PDF is ready to download.');
        } else if (pdfResults.length > 1) {
          showStatus(`Packing ${describeSplitPdfCount(pdfResults.length)} into one archive locally…`);
          await nextFrame();

          // A set of documents is one download too, packed here from the same
          // files the individual links point at.
          const entries = await Promise.all(
            pdfResults.map(async (pdf) => ({
              name: pdf.name,
              data: new Uint8Array(await pdf.blob.arrayBuffer()),
            })),
          );
          const archive = new Blob([createZipArchive(entries)], { type: zipMimeType });
          const pages = pdfResults.reduce((total, pdf) => total + pdf.pages, 0);
          const total = pdfResults.reduce((bytes, pdf) => bytes + pdf.blob.size, 0);

          resultUrl = URL.createObjectURL(archive);
          resultTitle.textContent = 'Your PDFs are ready.';
          resultDetails.textContent = `${describeSplitPdfCount(pdfResults.length)} · ${describePdfPageCount(pages)} · ${formatFileSize(total)}`;
          resultFigure.hidden = true;
          resultList.replaceChildren(...pdfResults.map(renderPdfResultItem));
          resultList.hidden = false;
          download.textContent = `Download all ${pdfResults.length} PDFs`;
          download.href = resultUrl;
          download.download = getSplitPdfArchiveName(setSourceName ?? 'document.pdf');
          result.hidden = false;
          showStatus('Done. Your PDFs are ready to download.');
        } else if (payloads.length > 1) {
          showStatus(`Packing ${describePdfImageCount(payloads.length)} into one archive locally…`);
          await nextFrame();

          // The archive is written here, from the same files the individual
          // links point at: one download at the end, and still no server.
          const entries = await Promise.all(
            payloads.map(async (payload) => ({
              name: payload.file.name,
              data: new Uint8Array(await payload.file.arrayBuffer()),
            })),
          );
          const archive = new Blob([createZipArchive(entries)], { type: zipMimeType });
          const total = payloads.reduce((bytes, payload) => bytes + payload.file.size, 0);

          resultUrl = URL.createObjectURL(archive);
          resultTitle.textContent = 'Your images are ready.';
          resultDetails.textContent = `${describePdfImageCount(payloads.length)} · ${getFormatLabel(outputFormat)} · ${formatFileSize(total)}`;
          resultFigure.hidden = true;
          resultList.replaceChildren(...payloads.map(renderResultItem));
          resultList.hidden = false;
          download.textContent = `Download all ${payloads.length} pages`;
          download.href = resultUrl;
          download.download = getPdfImageArchiveName(setSourceName ?? 'document.pdf');
          result.hidden = false;
          showStatus('Done. Your images are ready to download.');
        } else {
          const [output] = payloads;
          resultUrl = URL.createObjectURL(output.file);
          resultImage.src = resultUrl;
          resultDetails.textContent = `${getFormatLabel(outputFormat)} · ${output.width} × ${output.height} px · ${formatFileSize(output.file.size)}`;
          download.href = resultUrl;
          download.download = output.file.name;
          result.hidden = false;
          showStatus('Done. Your final image is ready to download.');
        }
      } catch (caughtError) {
        showError(caughtError instanceof Error ? caughtError.message : 'This flow could not be processed. Try another image or adjust the step settings.');
        clearStatus();
      } finally {
        isRunning = false;
        runButton.textContent = 'Run flow';
        renderSteps();
      }
    };

    sourceSelect.addEventListener('click', () => sourceInput.click());
    sourceInput.addEventListener('change', () => void addSources([...(sourceInput.files ?? [])]));
    sourceClear.addEventListener('click', clearSources);
    sourceList.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-source-action]');
      if (!button || isRunning) return;

      const id = Number(button.dataset.sourceId);
      const index = sources.findIndex((source) => source.id === id);
      if (index === -1) return;

      if (button.dataset.sourceAction === 'up') sources = reorderPdfImages(sources, index, index - 1);
      if (button.dataset.sourceAction === 'down') sources = reorderPdfImages(sources, index, index + 1);
      if (button.dataset.sourceAction === 'remove') {
        releaseSource(sources[index]);
        sources = sources.filter((source) => source.id !== id);
      }

      resetResult();
      clearError();
      renderSteps();
    });
    categorySelect.addEventListener('change', () => {
      const chosen = categorySelect.value;

      if (!isFlowCategoryId(chosen) || chosen === categoryId || isRunning) {
        categorySelect.value = categoryId;
        return;
      }

      categoryId = chosen;

      // A chain built for one starting payload cannot read another, and a
      // half-kept chain would be a flow the visitor did not assemble. The
      // sources go with it: they are files of the wrong kind now.
      for (const source of sources) releaseSource(source);
      sources = [];
      steps = [];
      sourceInput.value = '';
      outputFormatFromRecipe = false;
      resetResult();
      clearError();
      clearStatus();
      categorySummary.textContent = category().summary;
      renderSteps();
    });
    finalFormat.addEventListener('change', () => {
      outputFormat = finalFormat.value as ImageOutputFormat;
      resetResult();
      renderSteps();
    });
    addStepButton.addEventListener('click', () => {
      const toolSlug = addSelect.value;
      if (!isAvailableFlowToolSlug(toolSlug) || !availableStepSlugs().includes(toolSlug)) return;
      if (steps.length > 0 && !canFlowTo(steps.at(-1)?.toolSlug ?? toolSlug, toolSlug)) return;
      steps.push(defaultStep(toolSlug));
      resetResult();
      clearStatus();
      renderSteps();
    });
    stepList.addEventListener('input', (event) => {
      const target = event.target;
      if (target instanceof HTMLInputElement || target instanceof HTMLSelectElement) updateStepSetting(target);
    });
    stepList.addEventListener('change', (event) => {
      const target = event.target;
      if (target instanceof HTMLInputElement || target instanceof HTMLSelectElement) updateStepSetting(target);
    });
    stepList.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-step-action]');
      if (!button || isRunning) return;
      const id = Number(button.dataset.stepId);
      const index = steps.findIndex((step) => step.id === id);
      if (index === -1) return;
      if (button.dataset.stepAction === 'remove') steps.splice(index, 1);
      if (button.dataset.stepAction === 'up' && index > 0 && canReorder(index, index - 1)) [steps[index - 1], steps[index]] = [steps[index], steps[index - 1]];
      if (button.dataset.stepAction === 'down' && index < steps.length - 1 && canReorder(index, index + 1)) [steps[index], steps[index + 1]] = [steps[index + 1], steps[index]];
      resetResult();
      clearStatus();
      applySourceLimit();
      renderSteps();
    });
    const currentRecipe = (): Recipe => ({
      category: categoryId,
      outputFormat,
      steps: steps.map((step) => ({
        toolSlug: step.toolSlug,
        ...(step.toolSlug === 'resize-image' ? { width: step.width, height: step.height } : {}),
        ...(step.toolSlug === 'compress-image' ? { quality: step.quality } : {}),
        ...(step.toolSlug === 'crop-image' ? { ratio: step.ratio } : {}),
        ...(step.toolSlug === 'jpg-to-pdf' ? { pageSize: step.pageSize, orientation: step.orientation } : {}),
        ...(step.toolSlug === 'pdf-to-jpg' ? { resolution: step.resolution } : {}),
      })),
    });
    const applyRecipe = (recipe: Recipe) => {
      // The starting payload comes first: the chain below it was validated
      // against this category, and the chooser has to agree with it.
      if (recipe.category) {
        categoryId = recipe.category;
        categorySelect.value = categoryId;
        categorySummary.textContent = category().summary;
      }

      // Defaults come from defaultStep, so a step whose settings the recipe
      // omits behaves exactly like one added by hand.
      steps = recipe.steps.map((step) => ({
        ...defaultStep(step.toolSlug),
        ...(step.width !== undefined ? { width: step.width } : {}),
        ...(step.height !== undefined ? { height: step.height } : {}),
        ...(step.quality !== undefined ? { quality: step.quality } : {}),
        ...(step.ratio !== undefined ? { ratio: step.ratio } : {}),
        ...(step.pageSize !== undefined ? { pageSize: step.pageSize } : {}),
        ...(step.orientation !== undefined ? { orientation: step.orientation } : {}),
        ...(step.resolution !== undefined ? { resolution: step.resolution } : {}),
      }));
      if (recipe.outputFormat) {
        // A link may name a format the chain cannot honour — every image flow
        // written before this release defaulted to WebP, and one ending in a
        // PDF now offers only the two formats a page embeds. Keeping the link
        // readable and moving the format is better than refusing the flow.
        outputFormat = getUsableFlowFormat(getFlowFormatControl(recipe.steps.map((step) => step.toolSlug)), recipe.outputFormat)
          ?? recipe.outputFormat;
        outputFormatFromRecipe = true;
      }
    };
    const copyRecipeLink = () => {
      const encoded = encodeRecipe(currentRecipe());

      if (!encoded) {
        recipeStatus.textContent = 'This flow is too long to share as a link.';
        return;
      }

      const link = `${window.location.origin}${window.location.pathname}${encoded}`;
      window.history.replaceState(null, '', encoded);

      if (!navigator.clipboard?.writeText) {
        recipeStatus.textContent = 'Copy is unavailable in this browser. The link is in the address bar.';
        return;
      }

      navigator.clipboard
        .writeText(link)
        .then(() => { recipeStatus.textContent = 'Recipe link copied. It carries these settings only, never your files.'; })
        .catch(() => { recipeStatus.textContent = 'Could not copy automatically. The link is in the address bar.'; });
    };

    resultClear.addEventListener('click', resetResult);
    runButton.addEventListener('click', () => void runFlow());
    copyRecipe.addEventListener('click', copyRecipeLink);

    // An unreadable recipe is ignored whole: the builder renders its default
    // state rather than a chain the visitor cannot tell is incomplete.
    const openedRecipe = decodeRecipe(window.location.hash);
    if (openedRecipe) applyRecipe(openedRecipe);

    renderSteps();
  }
</script>
