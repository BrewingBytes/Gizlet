---
import { toolSearchPlaceholder } from '../data/tool-search-examples';
---

<dialog
  id="tool-search-overlay"
  class="search-overlay"
  aria-labelledby="search-overlay-title"
  data-search-overlay
>
  <div class="search-overlay__header">
    <div>
      <p class="metadata">Find a Gizlet</p>
      <h2 id="search-overlay-title">What do you need?</h2>
    </div>
    <button class="button-secondary search-overlay__close" type="button" data-search-close>
      Close
    </button>
  </div>

  <div class="search-overlay__panel" data-tool-search-panel>
    <label for="global-tool-search">Search Gizlets</label>
    <input
      id="global-tool-search"
      type="search"
      placeholder={toolSearchPlaceholder}
      autocomplete="off"
      data-tool-search-input
    />
    <p class="search-overlay__status" aria-live="polite" data-tool-search-status></p>
    <ol class="search-overlay__results" data-tool-search-results></ol>
  </div>
</dialog>

<style>
  .search-overlay {
    width: min(calc(100% - (2 * var(--space-4))), 44rem);
    max-height: min(40rem, calc(100% - (2 * var(--space-4))));
    margin: auto;
    padding: var(--space-4);
    overflow: auto;
    border: var(--border-strong-width) solid var(--text);
    border-radius: var(--border-radius);
    background: var(--surface);
    color: var(--text);
  }

  .search-overlay::backdrop {
    background: rgb(15 23 42 / 72%);
  }

  .search-overlay__header {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .search-overlay__header .metadata {
    margin-bottom: var(--space-1);
  }

  .search-overlay__header h2 {
    margin-bottom: var(--space-4);
  }

  .search-overlay__close {
    flex: 0 0 auto;
  }

  .search-overlay__panel > label {
    display: block;
    margin-bottom: var(--space-1);
    font-weight: 700;
  }

  .search-overlay__panel input {
    border-width: var(--border-strong-width);
    border-color: var(--text);
  }

  .search-overlay__status {
    min-height: 1.25rem;
    margin: var(--space-2) 0;
    color: var(--text-muted);
    font-size: var(--font-size-sm);
  }

  .search-overlay__results {
    margin: 0;
    padding: 0;
    border-top: var(--border-width) solid var(--border);
    list-style: none;
  }

  .search-overlay__results li {
    border-bottom: var(--border-width) solid var(--border);
  }

  :global(.tool-search-result) {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-2);
    color: var(--text);
    text-decoration: none;
  }

  :global(.tool-search-result:hover) {
    background: var(--background);
    color: var(--text);
  }

  :global(.tool-search-result__details) {
    display: grid;
    gap: var(--space-1);
  }

  :global(.tool-search-result__details strong) {
    font-family: var(--font-display);
    font-size: var(--font-size-lg);
  }

  :global(.tool-search-result__details span) {
    color: var(--text-muted);
  }

  :global(.tool-search-result__category) {
    align-self: center;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  @media (max-width: 32rem) {
    .search-overlay {
      padding: var(--space-3);
    }
  }
</style>
