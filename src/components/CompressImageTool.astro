---
import { imageTargetSizePresets } from '../data/image-target-size';
import { toolRegistry } from '../data/tools';

/**
 * A target the browser cannot reach is answered with the Gizlet that removes
 * pixels, so the route comes from the registry rather than from this file.
 */
const resizeImage = toolRegistry.find((tool) => tool.slug === 'resize-image');

if (!resizeImage) throw new Error('Compress Image needs the Resize Image entry to link to.');
---

<section class="compress-image-tool" data-compress-image-tool>
  <div class="compress-image-tool__picker" data-drop-zone>
    <input
      id="compress-image-file"
      class="compress-image-tool__file-input"
      type="file"
      accept="image/jpeg,image/png,image/webp,image/avif,image/bmp,.jpg,.jpeg,.png,.webp,.avif,.bmp"
      aria-label="Select an image to compress"
      data-file-input
      multiple
      hidden
    />
    <p class="metadata">One image, or a batch of them</p>
    <h2>Drop images here</h2>
    <p>JPEG, PNG, WebP, AVIF, or BMP. Nothing leaves this device.</p>
    <button type="button" class="button-secondary" data-select-file>Choose images</button>
  </div>

  <p class="compress-image-tool__error" data-error role="alert" hidden></p>

  <div class="compress-image-tool__editor" data-editor hidden>
    <figure class="compress-image-tool__preview">
      <img data-preview-image alt="Selected image preview" />
      <figcaption data-input-name></figcaption>
    </figure>

    <div class="compress-image-tool__settings">
      <div>
        <label for="compress-output-format">Output format</label>
        <select id="compress-output-format" data-output-format>
          <option value="image/jpeg">JPEG</option>
          <option value="image/png">PNG</option>
          <option value="image/webp">WebP</option>
        </select>
      </div>
      <fieldset class="compress-image-tool__modes" aria-describedby="compress-mode-note" data-mode-control>
        <legend>Compress by</legend>
        <label>
          <input type="radio" name="compress-mode" value="quality" data-mode checked />
          Quality
        </label>
        <label>
          <input type="radio" name="compress-mode" value="target" data-mode />
          Target file size
        </label>
      </fieldset>
      <div class="compress-image-tool__mode-panel" data-quality-control>
        <label for="compress-quality">Quality <output for="compress-quality" data-quality-value>82%</output></label>
        <input id="compress-quality" type="range" min="40" max="100" value="82" data-quality />
        <p class="utility-text">JPEG and WebP only</p>
      </div>
      <div class="compress-image-tool__mode-panel" data-target-control hidden>
        <label for="compress-target">Size limit</label>
        <select id="compress-target" data-target-preset>
          {imageTargetSizePresets.map((preset) => <option value={preset.bytes}>{preset.label}</option>)}
          <option value="custom">Custom size</option>
        </select>
        <div class="compress-image-tool__custom-target" data-target-custom-field hidden>
          <label for="compress-target-custom">Custom size, in KB</label>
          <input
            id="compress-target-custom"
            type="number"
            min="1"
            step="1"
            value="250"
            inputmode="numeric"
            data-target-custom
          />
        </div>
        <p class="utility-text">KB is 1,000 bytes · MB is 1,000,000 · JPEG and WebP only</p>
      </div>
    </div>

    <p id="compress-mode-note" class="compress-image-tool__note" data-format-note hidden></p>

    <div class="compress-image-tool__actions">
      <button type="button" data-compress>Compress it</button>
      <button type="button" class="button-secondary" data-cancel hidden>Stop</button>
      <button type="button" class="button-secondary" data-clear>Choose other images</button>
    </div>
  </div>

  <section class="compress-image-tool__result" data-result aria-live="polite" hidden>
    <p class="metadata">Ready to download</p>
    <h2 data-result-title>Your image is ready.</h2>
    <p class="compress-image-tool__target-outcome" data-target-outcome hidden></p>
    <dl data-result-dl>
      <div><dt>Before</dt><dd data-before-size></dd></div>
      <div><dt>After</dt><dd data-after-size></dd></div>
      <div><dt>Change</dt><dd data-size-change></dd></div>
    </dl>

    <!-- A batch is a list of rows: every picture that worked is a download of
         its own, and every one that did not says why beside it. The comparison
         slider belongs to a single picture and is put away for a batch. -->
    <ul class="compress-image-tool__result-list" data-result-list hidden></ul>
    <template data-result-item-template>
      <li>
        <img data-item-image alt="" />
        <div>
          <p data-item-name></p>
          <a data-item-download>Download</a>
        </div>
      </li>
    </template>
    <template data-failure-item-template>
      <li data-failed>
        <div>
          <p data-item-name></p>
          <p data-item-reason></p>
        </div>
      </li>
    </template>

    <section class="compress-image-tool__comparison" aria-labelledby="comparison-title" data-comparison>
      <div class="compress-image-tool__comparison-heading">
        <div>
          <p class="metadata">Look closer</p>
          <h3 id="comparison-title">Original / compressed</h3>
        </div>
        <p class="utility-text" data-comparison-dimensions></p>
      </div>
      <div class="compress-image-tool__comparison-stage" data-comparison-stage>
        <img data-comparison-original alt="Original image" />
        <div class="compress-image-tool__comparison-overlay" data-comparison-overlay aria-hidden="true">
          <img data-comparison-result alt="" />
        </div>
        <span class="compress-image-tool__comparison-label compress-image-tool__comparison-label--original" aria-hidden="true">Original</span>
        <span class="compress-image-tool__comparison-label compress-image-tool__comparison-label--compressed" aria-hidden="true">Compressed</span>
        <span class="compress-image-tool__comparison-divider" data-comparison-divider aria-hidden="true"><i></i></span>
        <input
          type="range"
          min="0"
          max="100"
          value="50"
          aria-label="Compare original and compressed image"
          aria-describedby="comparison-help"
          data-comparison-slider
        />
      </div>
      <p id="comparison-help" class="compress-image-tool__comparison-help">Drag to compare. The dimensions stay the same.</p>
    </section>
    <!-- A limit the browser could not reach is not a failure with nothing in
         it: the smallest attempt is still a file, and it is offered as exactly
         that, beside the Gizlet that can do the thing compression cannot. -->
    <div class="compress-image-tool__advice" data-target-advice hidden>
      <p data-target-advice-text></p>
      <a href={resizeImage.path} data-resize-link>{resizeImage.name}</a>
    </div>

    <div class="compress-image-tool__result-actions">
      <a class="compress-image-tool__download" data-download>Download image</a>
      <button type="button" class="button-secondary" data-result-clear>Choose other images</button>
    </div>
  </section>
</section>

<style>
  .compress-image-tool {
    border: var(--border-strong-width) solid var(--text);
    background: var(--surface);
  }

  .compress-image-tool__picker {
    padding: var(--space-5);
    border: 2px dashed var(--border);
    outline: 0;
    outline-offset: -0.5rem;
    text-align: center;
  }

  .compress-image-tool__picker[data-dragging='true'] {
    border-color: var(--color-amber);
    background: color-mix(in srgb, var(--color-amber) 12%, var(--surface));
  }

  .compress-image-tool__picker[hidden] {
    display: none;
  }

  .compress-image-tool__result-list[hidden] { display: none; }
  .compress-image-tool__result-list { display: grid; gap: var(--space-2); margin: 0 0 var(--space-4); padding: 0; list-style: none; }
  .compress-image-tool__result-list li { display: flex; align-items: center; gap: var(--space-3); padding: var(--space-2); border: var(--border-width) solid var(--border); background: var(--background); }
  .compress-image-tool__result-list li[data-failed] { border-left: var(--border-strong-width) solid var(--color-red); }
  .compress-image-tool__result-list img { width: 3.5rem; height: 3.5rem; object-fit: contain; background: var(--surface); }
  .compress-image-tool__result-list p { margin: 0; overflow-wrap: anywhere; font-family: var(--font-mono); font-size: var(--font-size-xs); }
  .compress-image-tool__result-list li[data-failed] p + p { color: var(--color-red); }
  .compress-image-tool__result-list a { display: inline-block; margin-top: var(--space-1); font-size: var(--font-size-sm); font-weight: 700; }

  .compress-image-tool__picker h2 {
    margin-bottom: var(--space-2);
  }

  .compress-image-tool__picker p:not(.metadata) {
    margin-bottom: var(--space-4);
    color: var(--text-muted);
  }

  .compress-image-tool__file-input {
    display: none;
  }

  .compress-image-tool__error {
    margin: var(--space-3);
    padding: var(--space-3);
    border-left: var(--border-strong-width) solid var(--color-red);
    color: var(--color-red);
  }

  .compress-image-tool__editor,
  .compress-image-tool__result {
    padding: var(--space-4);
    border-top: var(--border-width) solid var(--border);
  }

  .compress-image-tool__editor {
    display: grid;
    gap: var(--space-4);
  }

  .compress-image-tool__editor[hidden],
  .compress-image-tool__result[hidden] {
    display: none;
  }

  .compress-image-tool__preview {
    margin: 0;
  }

  .compress-image-tool__preview img {
    display: block;
    max-width: 100%;
    max-height: 24rem;
    margin: 0 auto;
    border: var(--border-width) solid var(--border);
  }

  .compress-image-tool__preview figcaption {
    margin-top: var(--space-2);
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
  }

  .compress-image-tool__settings {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
    padding-top: var(--space-3);
    border-top: var(--border-width) solid var(--border);
  }

  .compress-image-tool__settings label {
    display: flex;
    justify-content: space-between;
    gap: var(--space-2);
    margin-bottom: var(--space-1);
    font-weight: 700;
  }

  .compress-image-tool__modes {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .compress-image-tool__modes legend {
    margin-bottom: var(--space-1);
    padding: 0;
    font-weight: 700;
  }

  .compress-image-tool__modes label {
    display: inline-flex;
    align-items: center;
    justify-content: flex-start;
    gap: var(--space-2);
    min-height: 2.5rem;
    margin: 0 var(--space-3) 0 0;
    font-weight: 400;
  }

  .compress-image-tool__modes input {
    width: 1.125rem;
    height: 1.125rem;
    flex: none;
    accent-color: var(--color-amber);
  }

  /* Quality and target are the same slot: only one of them is ever the way the
     next run is described, so they take the full row rather than sitting beside
     each other pretending both apply. */
  .compress-image-tool__mode-panel {
    grid-column: 1 / -1;
  }

  .compress-image-tool__mode-panel[hidden] {
    display: none;
  }

  .compress-image-tool__custom-target {
    margin-top: var(--space-2);
  }

  .compress-image-tool__custom-target[hidden] {
    display: none;
  }

  .compress-image-tool__settings select,
  .compress-image-tool__settings input[type='number'] {
    width: 100%;
  }

  /* A sentence, so it is set as one rather than in the uppercase metadata
     style the short labels beside it use. */
  .compress-image-tool__note {
    margin: 0;
    color: var(--text-muted);
    font-size: var(--font-size-sm);
  }

  .compress-image-tool__note[hidden] {
    display: none;
  }

  .compress-image-tool__target-outcome {
    margin: 0 0 var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
  }

  .compress-image-tool__target-outcome[hidden] {
    display: none;
  }

  .compress-image-tool__advice {
    margin-bottom: var(--space-4);
    padding: var(--space-3);
    border-left: var(--border-strong-width) solid var(--color-amber);
    background: var(--background);
  }

  .compress-image-tool__advice[hidden] {
    display: none;
  }

  .compress-image-tool__advice p {
    margin: 0 0 var(--space-2);
  }

  .compress-image-tool__settings output {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
    font-weight: 400;
  }

  .compress-image-tool__settings input[type='range'] {
    width: 100%;
    accent-color: var(--color-amber);
  }

  .compress-image-tool__settings .utility-text {
    margin: var(--space-1) 0 0;
  }

  .compress-image-tool__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .compress-image-tool__result h2 {
    margin-bottom: var(--space-4);
  }

  .compress-image-tool__result dl {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-2);
    margin: 0 0 var(--space-4);
  }

  .compress-image-tool__result dl div {
    padding: var(--space-2);
    border-top: var(--border-width) solid var(--border);
  }

  .compress-image-tool__result dt {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    text-transform: uppercase;
  }

  .compress-image-tool__result dd {
    margin: var(--space-1) 0 0;
    font-weight: 700;
  }

  .compress-image-tool__comparison {
    margin-bottom: var(--space-4);
    padding-top: var(--space-4);
    border-top: var(--border-width) solid var(--border);
  }

  .compress-image-tool__comparison-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }

  .compress-image-tool__comparison-heading .metadata,
  .compress-image-tool__comparison-heading h3,
  .compress-image-tool__comparison-heading .utility-text {
    margin: 0;
  }

  .compress-image-tool__comparison-heading h3 {
    margin-top: var(--space-1);
  }

  .compress-image-tool__comparison-stage {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: var(--border);
  }

  .compress-image-tool__comparison-stage:focus-within {
    outline: var(--focus-ring);
    outline-offset: var(--focus-offset);
  }

  .compress-image-tool__comparison-stage > img,
  .compress-image-tool__comparison-overlay,
  .compress-image-tool__comparison-overlay img {
    display: block;
    width: 100%;
    height: 100%;
  }

  .compress-image-tool__comparison-stage > img,
  .compress-image-tool__comparison-overlay img {
    object-fit: contain;
    background: var(--surface);
  }

  .compress-image-tool__comparison-overlay {
    position: absolute;
    inset: 0;
    clip-path: inset(0 50% 0 0);
  }

  .compress-image-tool__comparison-label {
    position: absolute;
    top: var(--space-2);
    padding: 0.25rem var(--space-1);
    background: var(--surface);
    color: var(--text);
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .compress-image-tool__comparison-label--original {
    right: var(--space-2);
  }

  .compress-image-tool__comparison-label--compressed {
    left: var(--space-2);
  }

  .compress-image-tool__comparison-divider {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: var(--border-strong-width);
    background: var(--text);
    pointer-events: none;
    transform: translateX(-50%);
  }

  .compress-image-tool__comparison-divider i {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 1.75rem;
    height: 1.75rem;
    border: var(--border-strong-width) solid var(--text);
    border-radius: 50%;
    background: var(--color-amber);
    transform: translate(-50%, -50%);
  }

  .compress-image-tool__comparison-stage input[type='range'] {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    cursor: ew-resize;
    opacity: 0;
  }

  .compress-image-tool__comparison-help {
    margin: var(--space-2) 0 0;
    color: var(--text-muted);
    font-size: var(--font-size-sm);
  }

  .compress-image-tool__download {
    display: inline-block;
    min-height: 2.75rem;
    padding: calc(var(--space-2) - 2px) var(--space-3);
    border: var(--border-strong-width) solid var(--button-background);
    background: var(--button-background);
    color: var(--button-text);
    font-weight: 700;
    line-height: 1.25;
    text-decoration: none;
  }

  .compress-image-tool__download:hover {
    color: var(--button-text);
    box-shadow: 3px 3px 0 var(--color-amber);
    transform: translate(-1px, -1px);
  }

  .compress-image-tool__result-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  @media (max-width: 36rem) {
    .compress-image-tool__picker,
    .compress-image-tool__editor,
    .compress-image-tool__result {
      padding: var(--space-3);
    }

    .compress-image-tool__settings,
    .compress-image-tool__result dl {
      grid-template-columns: 1fr;
    }

    .compress-image-tool__comparison-heading {
      align-items: start;
      flex-direction: column;
    }
  }
</style>

<script>
  import {
    formatFileSize,
    formatSizeChange,
    getInputImageFormat,
    getOutputFilename,
    getPreferredOutputFormat,
    isImageOutputFormat,
  } from '../data/image-compression';
  import {
    describeBatchCount,
    getBatchArchiveName,
    getBatchFailures,
    getBatchSuccesses,
    hasBatchOutput,
    summariseBatch,
    validateBatchSelection,
  } from '../data/image-batches';
  import {
    describeImageTargetResult,
    getImageTargetTitle,
    imageTargetSizePngExplanation,
    imageTargetSizeUnmetAdvice,
    parseImageTargetKilobytes,
    summariseImageTargetBatch,
    supportsImageTargetSize,
    type ImageTargetSizeDecision,
    type ImageTargetSizeMode,
  } from '../data/image-target-size';
  import { checkBatchSize, packImageArchive, readBatchSources, releaseBatch, runImageBatch, type BatchSource } from '../scripts/image-batch';
  import { encodeBrowserImage } from '../scripts/image-processing';
  import { createBrowserTargetImageEncoder, encodeImageToTargetSize } from '../scripts/image-target-size';

  const root = document.querySelector<HTMLElement>('[data-compress-image-tool]');

  if (root) {
    const fileInput = root.querySelector<HTMLInputElement>('[data-file-input]');
    const selectFileButton = root.querySelector<HTMLButtonElement>('[data-select-file]');
    const dropZone = root.querySelector<HTMLElement>('[data-drop-zone]');
    const editor = root.querySelector<HTMLElement>('[data-editor]');
    const previewImage = root.querySelector<HTMLImageElement>('[data-preview-image]');
    const inputName = root.querySelector<HTMLElement>('[data-input-name]');
    const error = root.querySelector<HTMLElement>('[data-error]');
    const outputFormat = root.querySelector<HTMLSelectElement>('[data-output-format]');
    const quality = root.querySelector<HTMLInputElement>('[data-quality]');
    const qualityValue = root.querySelector<HTMLOutputElement>('[data-quality-value]');
    const qualityControl = root.querySelector<HTMLElement>('[data-quality-control]');
    const modeInputs = [...root.querySelectorAll<HTMLInputElement>('[data-mode]')];
    const targetControl = root.querySelector<HTMLElement>('[data-target-control]');
    const targetPreset = root.querySelector<HTMLSelectElement>('[data-target-preset]');
    const targetCustomField = root.querySelector<HTMLElement>('[data-target-custom-field]');
    const targetCustom = root.querySelector<HTMLInputElement>('[data-target-custom]');
    const formatNote = root.querySelector<HTMLElement>('[data-format-note]');
    const targetOutcome = root.querySelector<HTMLElement>('[data-target-outcome]');
    const targetAdvice = root.querySelector<HTMLElement>('[data-target-advice]');
    const targetAdviceText = root.querySelector<HTMLElement>('[data-target-advice-text]');
    const compressButton = root.querySelector<HTMLButtonElement>('[data-compress]');
    const cancelButton = root.querySelector<HTMLButtonElement>('[data-cancel]');
    const clearButton = root.querySelector<HTMLButtonElement>('[data-clear]');
    const result = root.querySelector<HTMLElement>('[data-result]');
    const resultTitle = root.querySelector<HTMLElement>('[data-result-title]');
    const resultDl = root.querySelector<HTMLElement>('[data-result-dl]');
    const resultList = root.querySelector<HTMLUListElement>('[data-result-list]');
    const resultItemTemplate = root.querySelector<HTMLTemplateElement>('[data-result-item-template]');
    const failureItemTemplate = root.querySelector<HTMLTemplateElement>('[data-failure-item-template]');
    const comparison = root.querySelector<HTMLElement>('[data-comparison]');
    const beforeSize = root.querySelector<HTMLElement>('[data-before-size]');
    const afterSize = root.querySelector<HTMLElement>('[data-after-size]');
    const sizeChange = root.querySelector<HTMLElement>('[data-size-change]');
    const download = root.querySelector<HTMLAnchorElement>('[data-download]');
    const resultClearButton = root.querySelector<HTMLButtonElement>('[data-result-clear]');
    const comparisonStage = root.querySelector<HTMLElement>('[data-comparison-stage]');
    const comparisonOriginal = root.querySelector<HTMLImageElement>('[data-comparison-original]');
    const comparisonOverlay = root.querySelector<HTMLElement>('[data-comparison-overlay]');
    const comparisonResult = root.querySelector<HTMLImageElement>('[data-comparison-result]');
    const comparisonDimensions = root.querySelector<HTMLElement>('[data-comparison-dimensions]');
    const comparisonDivider = root.querySelector<HTMLElement>('[data-comparison-divider]');
    const comparisonSlider = root.querySelector<HTMLInputElement>('[data-comparison-slider]');

    if (
      !fileInput ||
      !selectFileButton ||
      !dropZone ||
      !editor ||
      !previewImage ||
      !inputName ||
      !error ||
      !outputFormat ||
      !quality ||
      !qualityValue ||
      !qualityControl ||
      modeInputs.length !== 2 ||
      !targetControl ||
      !targetPreset ||
      !targetCustomField ||
      !targetCustom ||
      !formatNote ||
      !targetOutcome ||
      !targetAdvice ||
      !targetAdviceText ||
      !compressButton ||
      !cancelButton ||
      !clearButton ||
      !result ||
      !resultTitle ||
      !resultDl ||
      !resultList ||
      !resultItemTemplate ||
      !failureItemTemplate ||
      !comparison ||
      !beforeSize ||
      !afterSize ||
      !sizeChange ||
      !download ||
      !resultClearButton ||
      !comparisonStage ||
      !comparisonOriginal ||
      !comparisonOverlay ||
      !comparisonResult ||
      !comparisonDimensions ||
      !comparisonDivider ||
      !comparisonSlider
    ) {
      throw new Error('Compress Image tool could not initialise.');
    }

    /**
     * The batch, which is one picture long in the ordinary case. One picture
     * keeps the comparison slider it always had; several get a list of rows and
     * one archive, and both come out of the same loop.
     */
    let sources: readonly BatchSource[] = [];
    let resultUrl: string | undefined;
    let itemUrls: string[] = [];

    /**
     * Which mode the visitor chose, rather than which radio is currently
     * usable. PNG cannot be aimed at a size, so choosing it disables the target
     * radio — but it does not throw the choice away, and picking JPEG or WebP
     * again brings the target control back as it was left.
     */
    let preferredMode: ImageTargetSizeMode = 'quality';

    /**
     * The run in flight, and the number that says whether it is still the one
     * being waited for. A stopped run, or one whose files were replaced while
     * it worked, comes back to find the token moved on and publishes nothing.
     */
    let activeRun: AbortController | undefined;
    let runToken = 0;
    const nextPaint = () => new Promise<void>((resolve) => requestAnimationFrame(() => requestAnimationFrame(() => resolve())));

    const updateComparison = () => {
      const position = Number(comparisonSlider.value);
      comparisonOverlay.style.clipPath = `inset(0 ${100 - position}% 0 0)`;
      comparisonDivider.style.left = `${position}%`;
    };

    const clearError = () => {
      error.hidden = true;
      error.textContent = '';
    };

    const showError = (message: string) => {
      error.textContent = message;
      error.hidden = false;
    };

    const revokeResultUrl = () => {
      if (resultUrl) {
        URL.revokeObjectURL(resultUrl);
        resultUrl = undefined;
      }
    };

    /**
     * Keeps the format, the two modes, and the target field agreeing with each
     * other.
     *
     * PNG is lossless: there is no quality to spend and so nothing for a
     * target search to vary. Rather than offer a control that silently does
     * nothing, the target mode is disabled for PNG and the reason is written
     * out under the settings.
     */
    const updateModeControls = () => {
      const canTarget = supportsImageTargetSize(outputFormat.value);
      const targeting = canTarget && preferredMode === 'target';

      for (const input of modeInputs) {
        if (input.value === 'target') input.disabled = !canTarget;
        input.checked = input.value === (canTarget ? preferredMode : 'quality');
      }

      quality.disabled = !canTarget || targeting;
      qualityControl.hidden = targeting;
      qualityControl.setAttribute('aria-disabled', String(quality.disabled));
      targetControl.hidden = !targeting;
      targetCustomField.hidden = targetPreset.value !== 'custom';
      formatNote.textContent = canTarget ? '' : imageTargetSizePngExplanation;
      formatNote.hidden = canTarget;
    };

    /** The limit the next run aims at, or nothing when the field cannot be read. */
    const readTargetBytes = (): number | undefined => {
      if (targetPreset.value !== 'custom') {
        const preset = Number(targetPreset.value);

        return Number.isSafeInteger(preset) && preset > 0 ? preset : undefined;
      }

      const parsed = parseImageTargetKilobytes(targetCustom.value);

      if (parsed.kind === 'invalid') {
        showError(parsed.message);

        return undefined;
      }

      return parsed.bytes;
    };

    /** What is left to try when the limit was not reached. */
    const showTargetAdvice = (unmet: boolean) => {
      targetAdviceText.textContent = unmet ? imageTargetSizeUnmetAdvice : '';
      targetAdvice.hidden = !unmet;
    };

    /** The actions as they read when nothing is running. */
    const readyToCompress = () => {
      cancelButton.hidden = true;
      compressButton.disabled = false;
      compressButton.textContent =
        sources.length > 1 ? `Compress ${describeBatchCount(sources.length)}` : 'Compress it';
    };

    /**
     * Ends the run in flight, if there is one.
     *
     * Moving the token is the half that matters: aborting asks the search to
     * stop, and the token makes whatever it hands back afterwards unpublishable
     * whether it noticed or not. The settings are left exactly as they were, so
     * stopping is a pause rather than a reset.
     */
    const cancelRun = () => {
      activeRun?.abort();
      activeRun = undefined;
      runToken += 1;
      readyToCompress();
    };

    const resetResult = () => {
      revokeResultUrl();
      for (const url of itemUrls) URL.revokeObjectURL(url);
      itemUrls = [];
      result.hidden = true;
      resultDl.hidden = false;
      comparison.hidden = false;
      resultList.hidden = true;
      resultList.replaceChildren();
      targetOutcome.hidden = true;
      targetOutcome.textContent = '';
      showTargetAdvice(false);
      download.removeAttribute('href');
      download.removeAttribute('download');
      comparisonOriginal.removeAttribute('src');
      comparisonResult.removeAttribute('src');
      comparisonDimensions.textContent = '';
      comparisonStage.style.removeProperty('aspect-ratio');
      comparisonSlider.value = '50';
      updateComparison();
    };

    const resetTool = () => {
      cancelRun();
      releaseBatch(sources);
      sources = [];
      fileInput.value = '';
      resetResult();
      previewImage.removeAttribute('src');
      dropZone.hidden = false;
      editor.hidden = true;
      clearError();
    };

    const selectFiles = async (chosen: readonly File[]) => {
      resetTool();

      if (chosen.length === 0) return;

      const problem = validateBatchSelection(chosen);

      if (problem) {
        showError(chosen.length === 1 ? 'Choose a JPEG, PNG, WebP, AVIF, or BMP image.' : problem);
        return;
      }

      dropZone.hidden = true;

      const { sources: read, failures } = await readBatchSources(chosen);

      // A file that will not decode is one row lost, not the whole batch — but
      // a batch where nothing decoded is an error like any other.
      if (read.length === 0) {
        releaseBatch(read);
        dropZone.hidden = false;
        showError(failures[0]?.reason ?? 'This image could not be read.');
        return;
      }

      const tooMuch = checkBatchSize(read);

      if (tooMuch) {
        releaseBatch(read);
        dropZone.hidden = false;
        showError(tooMuch);
        return;
      }

      sources = read;

      const [first] = sources;
      const totalBytes = sources.reduce((bytes, source) => bytes + source.file.size, 0);

      previewImage.src = first.previewUrl;
      inputName.textContent = sources.length === 1
        ? `${first.file.name} · ${formatFileSize(first.file.size)}`
        : `${describeBatchCount(sources.length)} · ${formatFileSize(totalBytes)}`;
      outputFormat.value = getPreferredOutputFormat(getInputImageFormat(first.file));
      compressButton.textContent = sources.length === 1 ? 'Compress it' : `Compress ${describeBatchCount(sources.length)}`;
      updateModeControls();
      editor.hidden = false;

      if (failures.length > 0) {
        showError(`${failures.length} of the chosen files could not be read: ${failures.map((failure) => failure.name).join(', ')}.`);
      }
    };

    /** One finished row: the file, and the line the list shows beside it. */
    const renderRow = (file: File, detail: string, thumbnail: string) => {
      const fragment = resultItemTemplate.content.cloneNode(true) as DocumentFragment;
      const image = fragment.querySelector<HTMLImageElement>('[data-item-image]');
      const name = fragment.querySelector<HTMLElement>('[data-item-name]');
      const link = fragment.querySelector<HTMLAnchorElement>('[data-item-download]');

      if (image) image.src = thumbnail;
      if (name) name.textContent = `${file.name} · ${detail}`;
      if (link) {
        link.href = thumbnail;
        link.download = file.name;
        link.setAttribute('aria-label', `Download ${file.name}`);
      }

      return fragment;
    };

    const renderFailure = (failure: { readonly name: string; readonly reason: string }) => {
      const fragment = failureItemTemplate.content.cloneNode(true) as DocumentFragment;
      const name = fragment.querySelector<HTMLElement>('[data-item-name]');
      const reason = fragment.querySelector<HTMLElement>('[data-item-reason]');

      if (name) name.textContent = failure.name;
      if (reason) reason.textContent = failure.reason;

      return fragment;
    };

    /** One finished picture, and what the target search made of it. */
    interface CompressedImage {
      readonly file: File;
      readonly source: BatchSource;
      readonly target?: {
        readonly kind: ImageTargetSizeDecision['kind'];
        readonly actualBytes: number;
        readonly limit: number;
      };
    }

    const compressImages = async () => {
      if (sources.length === 0 || !isImageOutputFormat(outputFormat.value)) {
        return;
      }

      const format = outputFormat.value;

      // `supportsImageTargetSize` narrows the format rather than only answering
      // about it, so a target run carries a format the engine accepts instead
      // of a flag standing next to one it might refuse.
      const targetFormat =
        preferredMode === 'target' && supportsImageTargetSize(format) ? format : undefined;
      const limit = targetFormat ? readTargetBytes() : undefined;

      // A limit that cannot be read is answered before anything is encoded, so
      // the panel the visitor is looking at is not cleared for a run that was
      // never going to produce a file.
      if (targetFormat && limit === undefined) return;

      const many = sources.length > 1;
      const controller = new AbortController();

      clearError();
      resetResult();
      activeRun = controller;
      const token = ++runToken;
      compressButton.disabled = true;
      compressButton.textContent = 'Compressing…';
      cancelButton.hidden = false;
      await nextPaint();

      try {
        const outcomes = await runImageBatch(
          sources,
          async (source): Promise<CompressedImage> => {
            if (controller.signal.aborted) throw new Error('Stopped.');

            const dimensions = { width: source.width, height: source.height };
            const name = getOutputFilename(source.file.name, format);

            if (targetFormat === undefined || limit === undefined) {
              const blob = await encodeBrowserImage(source.image, dimensions, format, Number(quality.value) / 100);

              return { file: new File([blob], name, { type: blob.type }), source };
            }

            // Each picture gets the limit to itself: a batch is a set of
            // independent answers, not one budget shared between them.
            const found = await encodeImageToTargetSize(
              limit,
              createBrowserTargetImageEncoder(source.image, dimensions, targetFormat),
              { signal: controller.signal },
            );

            if (found.kind === 'cancelled') throw new Error('Stopped.');

            if (found.kind === 'encoding-failed') {
              throw found.error instanceof Error
                ? found.error
                : new Error('This image could not be compressed.');
            }

            return {
              file: new File([found.blob], name, { type: found.blob.type }),
              source,
              target: { kind: found.kind, actualBytes: found.actualBytes, limit },
            };
          },
          (position, total) => {
            // A stopped run still walks its remaining files to unwind, and it
            // must not narrate that over the button a stop already restored.
            if (token !== runToken) return;

            if (total > 1) compressButton.textContent = `Compressing ${position} of ${total}…`;
          },
        );

        // A stopped run, or one whose files were replaced while it worked, is
        // no longer the current one and publishes nothing: a stale result
        // overwriting a newer selection is worse than no result at all.
        if (token !== runToken || controller.signal.aborted) return;

        const outputs = getBatchSuccesses(outcomes);
        const failures = getBatchFailures(outcomes);

        if (!hasBatchOutput(outcomes)) {
          throw new Error(failures[0]?.reason ?? 'This image could not be compressed.');
        }

        editor.hidden = true;
        result.hidden = false;

        if (!many) {
          const [output] = outputs;

          resultUrl = URL.createObjectURL(output.file);
          resultTitle.textContent = 'Your image is ready.';
          beforeSize.textContent = formatFileSize(output.source.file.size);
          afterSize.textContent = formatFileSize(output.file.size);
          sizeChange.textContent = formatSizeChange(output.source.file.size, output.file.size);
          comparisonOriginal.src = output.source.previewUrl;
          comparisonResult.src = resultUrl;
          comparisonDimensions.textContent = `${output.source.width} × ${output.source.height} px`;
          comparisonStage.style.aspectRatio = `${output.source.width} / ${output.source.height}`;
          updateComparison();
          download.href = resultUrl;
          download.download = output.file.name;
          download.textContent = 'Download image';

          // The exact byte count rather than a rounded one: this file is about
          // to be handed to something that will measure it.
          if (output.target) {
            const { kind, actualBytes, limit: aimed } = output.target;

            resultTitle.textContent = getImageTargetTitle(kind);
            targetOutcome.textContent = describeImageTargetResult(kind, actualBytes, aimed);
            targetOutcome.hidden = false;
            download.textContent = kind === 'met' ? 'Download image' : 'Download best attempt';
            showTargetAdvice(kind === 'unmet');
          }

          return;
        }

        // A batch hands back one archive and the rows it was packed from, so a
        // visitor can take the lot or just the one they wanted.
        itemUrls = outputs.map((output) => URL.createObjectURL(output.file));
        comparison.hidden = true;
        resultList.hidden = false;
        resultList.replaceChildren(
          ...outputs.map((output, index) =>
            renderRow(
              output.file,
              output.target
                ? describeImageTargetResult(output.target.kind, output.target.actualBytes, output.target.limit)
                : `${formatFileSize(output.file.size)} · ${formatSizeChange(output.source.file.size, output.file.size)}`,
              itemUrls[index],
            ),
          ),
          ...failures.map(renderFailure),
        );

        const before = outputs.reduce((bytes, output) => bytes + output.source.file.size, 0);
        const after = outputs.reduce((bytes, output) => bytes + output.file.size, 0);
        const archive = await packImageArchive(outputs.map((output) => output.file));

        resultUrl = URL.createObjectURL(archive);
        resultTitle.textContent = `${summariseBatch(outcomes)} ready.`;
        beforeSize.textContent = formatFileSize(before);
        afterSize.textContent = formatFileSize(after);
        sizeChange.textContent = formatSizeChange(before, after);
        download.href = resultUrl;
        download.download = getBatchArchiveName('compressed');
        download.textContent = `Download all ${outputs.length} as a ZIP`;

        if (limit !== undefined) {
          const kinds = outputs.flatMap((output) => (output.target ? [output.target.kind] : []));

          targetOutcome.textContent = summariseImageTargetBatch(kinds, limit);
          targetOutcome.hidden = false;
          showTargetAdvice(kinds.includes('unmet'));
        }
      } catch (caughtError) {
        if (token !== runToken) return;

        showError(caughtError instanceof Error ? caughtError.message : 'This image could not be compressed.');
      } finally {
        if (token === runToken) {
          activeRun = undefined;
          readyToCompress();
        }
      }
    };

    selectFileButton.addEventListener('click', () => fileInput.click());
    fileInput.addEventListener('change', () => void selectFiles([...(fileInput.files ?? [])]));
    clearButton.addEventListener('click', resetTool);
    resultClearButton.addEventListener('click', resetTool);
    compressButton.addEventListener('click', () => void compressImages());
    cancelButton.addEventListener('click', cancelRun);
    outputFormat.addEventListener('change', updateModeControls);

    for (const input of modeInputs) {
      input.addEventListener('change', () => {
        if (!input.checked) return;

        preferredMode = input.value === 'target' ? 'target' : 'quality';
        clearError();
        updateModeControls();
      });
    }

    targetPreset.addEventListener('change', () => {
      clearError();
      updateModeControls();
    });
    targetCustom.addEventListener('input', clearError);
    quality.addEventListener('input', () => {
      qualityValue.value = `${quality.value}%`;
      qualityValue.textContent = `${quality.value}%`;
    });
    comparisonSlider.addEventListener('input', updateComparison);

    for (const eventName of ['dragenter', 'dragover']) {
      dropZone.addEventListener(eventName, (event) => {
        event.preventDefault();
        dropZone.dataset.dragging = 'true';
      });
    }

    for (const eventName of ['dragleave', 'drop']) {
      dropZone.addEventListener(eventName, (event) => {
        event.preventDefault();
        delete dropZone.dataset.dragging;
      });
    }

    dropZone.addEventListener('drop', (event) => void selectFiles([...(event.dataTransfer?.files ?? [])]));
    updateModeControls();
  }
</script>
